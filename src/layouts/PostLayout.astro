---
import BaseLayout from "./BaseLayout.astro";
import { ArrowLeft, ArrowRight, Copy, Moon, Sun } from "@lucide/astro";
const { frontmatter } = Astro.props;
const headings: { depth: number; slug: string; text: string }[] = Astro.props.headings ?? [];
const sections = headings.filter(({ depth }) => depth === 2 || depth === 3);
const date = new Date(frontmatter.pubDate);
const duplicateTitle = headings[0]?.depth === 1 && headings[0]?.text === frontmatter.title;
---
<BaseLayout title={`${frontmatter.title} — Miyuki`} description={frontmatter.description} theme="dark">
  <script slot="head" is:inline>
    try {
      document.documentElement.dataset.articleTheme = localStorage.getItem("miyuki-article-theme") === "light" ? "light" : "dark";
    } catch {
      document.documentElement.dataset.articleTheme = "dark";
    }
  </script>
  <div class="document-page">
    <article class="article-shell">
      <header class="article-header">
        <div class="article-tools">
          <a class="back" href="/blog/"><ArrowLeft size={16} aria-hidden="true" /> 全部文章</a>
          <label class="article-theme" title="切换到白色模式" hidden>
            <input type="checkbox" role="switch" name="article-theme" aria-label="白色模式" />
            <span class="theme-track" aria-hidden="true">
              <span class="theme-thumb"></span>
              <Moon class="theme-moon" size={18} stroke-width={1.8} />
              <Sun class="theme-sun" size={18} stroke-width={1.8} />
            </span>
          </label>
        </div>
        <div class="article-meta">
          <time datetime={date.toISOString()}>{date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}</time>
          <div class="article-tags">{frontmatter.tags?.map((tag: string) => <span>{tag}</span>)}</div>
        </div>
        <h1>{frontmatter.title}</h1>
        {frontmatter.description && <p>{frontmatter.description}</p>}
      </header>
      {sections.length > 0 && (
        <>
          <details class="mobile-toc">
            <summary>文章目录</summary>
            <nav aria-label="文章目录">
              <ol>{sections.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
            </nav>
          </details>
          <aside class="desktop-toc">
            <nav class="toc-sticky" aria-label="文章目录">
              <h2>文章目录</h2>
              <ol>{sections.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
            </nav>
          </aside>
        </>
      )}
      <div class:list={["article-body", { "duplicate-title": duplicateTitle }]}><slot /></div>
      <footer class="article-end"><span>End of note</span><a href="/blog/">继续阅读 <ArrowRight size={16} aria-hidden="true" /></a></footer>
      <template id="copy-icon-template"><Copy size={16} aria-hidden="true" /></template>
      <p class="copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
    </article>
  </div>
</BaseLayout>

<style is:global>
  html[data-article-theme="light"]:has(.document-page) {
    color-scheme: light;
    --paper: #fafaf8;
    --surface: #f0f0ed;
    --ink: #20201e;
    --white: #20201e;
    --muted: #62625c;
    --line: #d8d8d1;
    --accent: #426b0e;
    --cyan: #176e6c;
    --pink: #985078;
  }
  .document-page { background: var(--paper); color: var(--ink); min-height: 70vh; }
  .article-shell { position: relative; width: min(740px, calc(100% - 48px)); margin: 0 auto; padding: 56px 0 80px; }
  .article-header { margin-bottom: 48px; }
  .article-tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 32px; }
  .article-header .back { display: inline-flex; gap: 10px; align-items: center; padding: 8px 0; color: var(--accent); font-size: .875rem; }
  .article-theme { position: relative; display: inline-flex; width: 76px; height: 44px; flex: 0 0 76px; align-items: center; cursor: pointer; }
  .article-theme[hidden] { display: none; }
  .article-theme input { position: absolute; z-index: 3; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .theme-track { position: relative; display: block; width: 76px; height: 42px; border: 1px solid var(--line); border-radius: 21px; background: var(--surface); transition: background .2s ease; }
  .theme-thumb { position: absolute; top: 3px; left: 3px; width: 34px; height: 34px; border-radius: 50%; background: #f0f0ec; transition: transform .2s ease; }
  .article-theme svg { position: absolute; z-index: 1; top: 11px; }
  .theme-moon { left: 11px; color: #33332e; }
  .theme-sun { right: 11px; color: var(--muted); }
  .article-theme input:checked + .theme-track { background: #c2ff62; }
  .article-theme input:checked + .theme-track .theme-thumb { transform: translateX(34px); background: #0c0c0c; }
  .article-theme input:checked + .theme-track .theme-moon { color: #426b0e; }
  .article-theme input:checked + .theme-track .theme-sun { color: #c2ff62; }
  .article-theme input:focus-visible + .theme-track { outline: 2px solid var(--accent); outline-offset: 4px; }
  .article-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 16px 24px; padding-top: 20px; border-top: 1px solid var(--line); font: .75rem/1.6 var(--mono); color: var(--muted); }
  .article-tags { display: flex; flex-wrap: wrap; gap: 8px 14px; min-width: 0; }
  .article-tags span { color: var(--cyan); overflow-wrap: anywhere; }
  .article-tags span::before { content: "#"; opacity: .65; }
  .article-header h1 { margin: 28px 0 20px; font-size: 2.75rem; font-weight: 550; line-height: 1.25; overflow-wrap: anywhere; }
  .article-header > p { margin: 0; color: var(--muted); font-size: 1.0625rem; line-height: 1.8; overflow-wrap: anywhere; }
  .article-body { min-width: 0; font-size: 17px; line-height: 1.85; overflow-wrap: anywhere; }
  .article-body.duplicate-title > h1:first-child { display: none; }
  .article-body :is(h1,h2,h3,h4,h5,h6) { margin: 2em 0 .75em; font-weight: 600; line-height: 1.4; scroll-margin-top: 28px; }
  .article-body h1 { font-size: 2rem; }
  .article-body h2 { font-size: 1.5rem; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .article-body h3 { font-size: 1.25rem; }
  .article-body :is(h4,h5,h6) { font-size: 1.0625rem; }
  .article-body p { margin: 1.2em 0; }
  .article-body :is(ul,ol) { padding-left: 1.6em; margin: 1.2em 0; }
  .article-body li { padding-left: .25em; margin: .35em 0; }
  .article-body li::marker { color: var(--accent); }
  .article-body li > :is(ul,ol) { margin: .4em 0; }
  .document-page a { color: var(--accent); }
  .article-body a { text-decoration: underline; text-underline-offset: 4px; }
  .document-page a:hover { color: var(--ink); }
  .article-body img { width: auto; margin: 2em auto; border-radius: 4px; }
  .article-body :not(pre) > code { padding: .15em .35em; border: 1px solid var(--line); border-radius: 4px; background: var(--surface); color: var(--pink); font-family: var(--mono); font-size: .875em; box-decoration-break: clone; }
  .article-body pre { max-width: 100%; overflow-x: auto; padding: 22px; margin: 1.5em 0; border: 1px solid var(--line); border-radius: 4px; font: .875rem/1.7 var(--mono); tab-size: 2; }
  .article-body pre code { padding: 0; border: 0; background: none; font: inherit; white-space: pre; overflow-wrap: normal; }
  .article-body blockquote { margin: 1.5em 0; padding: 2px 0 2px 20px; border-left: 2px solid var(--accent); color: var(--muted); }
  .article-body blockquote > :first-child { margin-top: .5em; }
  .article-body blockquote > :last-child { margin-bottom: .5em; }
  .article-body hr { margin: 2em 0; border: 0; border-top: 1px solid var(--line); }
  .article-body table { display: block; width: max-content; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin: 1.5em 0; font-size: .9375rem; }
  .article-body :is(th,td) { padding: 12px 16px; border: 1px solid var(--line); min-width: 120px; text-align: left; }
  .article-body th { background: var(--surface); }
  .article-body input[type="checkbox"] { accent-color: var(--accent); }
  .article-end { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; margin-top: 56px; padding-top: 20px; border-top: 1px solid var(--line); color: var(--muted); font: .75rem var(--mono); }
  .article-end a { display: inline-flex; gap: 12px; align-items: center; }
  .desktop-toc { position: absolute; left: calc(100% + 40px); top: 56px; bottom: 80px; width: 180px; }
  .toc-sticky { position: sticky; top: 28px; max-height: calc(100vh - 56px); overflow-y: auto; padding: 4px 8px 4px 16px; border-left: 1px solid var(--line); }
  .toc-sticky h2 { margin: 0 0 16px; color: var(--muted); font-size: .8125rem; font-weight: 500; }
  .document-page nav ol { list-style: none; padding: 0; margin: 0; }
  .document-page nav li { margin: 0; }
  .document-page nav .nested { padding-left: 14px; }
  .document-page nav a { display: block; padding: 6px 0; color: var(--muted); font-size: .8125rem; line-height: 1.6; overflow-wrap: anywhere; }
  .document-page nav a[aria-current="location"] { color: var(--accent); }
  .mobile-toc { display: none; margin-bottom: 32px; padding: 14px 0; border-block: 1px solid var(--line); }
  .mobile-toc summary { color: var(--accent); font-size: .875rem; cursor: pointer; }
  .mobile-toc nav { margin-top: 12px; }
  .code-block { min-width: 0; margin: 1.5em 0; }
  .code-block pre { margin: 0; border-top-left-radius: 0; border-top-right-radius: 0; }
  .code-toolbar { display: flex; justify-content: flex-end; align-items: center; min-height: 40px; padding: 4px 10px; border: 1px solid var(--line); border-bottom: 0; border-radius: 4px 4px 0 0; background: var(--surface); }
  .copy-code { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 4px; background: transparent; color: var(--muted); cursor: pointer; }
  .copy-code:hover, .copy-code[data-copied] { color: var(--accent); }
  .copy-code:disabled { opacity: .5; }
  .copy-status { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  html:not([data-article-theme="light"]) .document-page .astro-code,
  html:not([data-article-theme="light"]) .document-page .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
  }
  @media (max-width: 1279px) { .desktop-toc { display: none; } .mobile-toc { display: block; } }
  @media (max-width: 760px) {
    .article-shell { width: calc(100% - 40px); padding: 36px 0 56px; }
    .article-header h1 { font-size: 2rem; }
    .article-header { margin-bottom: 32px; }
    .article-body { font-size: 16px; }
    .article-body pre { padding: 16px; font-size: .8125rem; }
  }
</style>

<script>
  let cleanup: (() => void) | undefined;
  function setupDocument() {
    cleanup?.();
    const article = document.querySelector<HTMLElement>(".article-shell");
    if (!article) return;
    const controller = new AbortController();
    const themeControl = article.querySelector<HTMLLabelElement>(".article-theme");
    const themeInput = article.querySelector<HTMLInputElement>('input[name="article-theme"]');
    function applyTheme(theme: string) {
      document.documentElement.dataset.articleTheme = theme === "light" ? "light" : "dark";
      if (themeInput) themeInput.checked = theme === "light";
      if (themeControl) themeControl.title = theme === "light" ? "切换到深色模式" : "切换到白色模式";
    }
    applyTheme(document.documentElement.dataset.articleTheme ?? "dark");
    if (themeControl) themeControl.hidden = false;
    themeInput?.addEventListener("change", () => {
      const theme = themeInput.checked ? "light" : "dark";
      applyTheme(theme);
      try { localStorage.setItem("miyuki-article-theme", theme); } catch {}
    }, { signal: controller.signal });
    const timers = new Set<ReturnType<typeof setTimeout>>();
    const status = article.querySelector<HTMLElement>(".copy-status");

    article.querySelectorAll<HTMLPreElement>(".article-body pre").forEach((pre, index) => {
      if (!pre.querySelector("code")) return;
      let wrapper = pre.closest<HTMLElement>(".code-block");
      if (!wrapper) {
        wrapper = document.createElement("div");
        wrapper.className = "code-block";
        const toolbar = document.createElement("div");
        toolbar.className = "code-toolbar";
        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy-code";
        button.title = "复制代码";
        button.setAttribute("aria-label", `复制第 ${index + 1} 段代码`);
        const iconTemplate = article.querySelector<HTMLTemplateElement>("#copy-icon-template");
        if (iconTemplate) button.append(iconTemplate.content.cloneNode(true));
        toolbar.append(button);
        pre.before(wrapper);
        wrapper.append(toolbar, pre);
      }
      const button = wrapper.querySelector<HTMLButtonElement>(".copy-code")!;
      pre.tabIndex = 0;
      pre.setAttribute("aria-label", `第 ${index + 1} 段代码`);
      button.addEventListener("click", async () => {
        if (status) status.textContent = "";
        button.disabled = true;
        try {
          await navigator.clipboard.writeText(pre.querySelector("code")!.textContent ?? "");
          if (controller.signal.aborted) return;
          button.title = "已复制";
          if (status) status.textContent = "代码已复制";
          button.setAttribute("data-copied", "");
        } catch {
          if (controller.signal.aborted) return;
          button.title = "复制失败，请手动选择代码";
          if (status) status.textContent = "复制失败，请手动选择代码";
        } finally {
          button.disabled = false;
        }
        const timer = setTimeout(() => { button.title = "复制代码"; button.removeAttribute("data-copied"); timers.delete(timer); }, 2000);
        timers.add(timer);
      }, { signal: controller.signal });
    });
    article.querySelectorAll<HTMLTableElement>(".article-body table").forEach((table) => {
      table.tabIndex = 0;
      table.setAttribute("aria-label", table.caption?.textContent || "文章表格");
    });

    const headings = Array.from(article.querySelectorAll<HTMLElement>(".article-body h2[id], .article-body h3[id]"));
    const links = Array.from(article.querySelectorAll<HTMLAnchorElement>("nav a[href^='#']"));
    let frame = 0;
    function updateSection() {
      frame = 0;
      let current = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= 100) current = heading;
      }
      for (const link of links) {
        if (current && decodeURIComponent(link.hash.slice(1)) === current.id) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    }
    function scheduleSection() { if (!frame) frame = requestAnimationFrame(updateSection); }
    document.addEventListener("scroll", scheduleSection, { passive: true, signal: controller.signal });
    window.addEventListener("resize", scheduleSection, { passive: true, signal: controller.signal });
    article.addEventListener("load", scheduleSection, { capture: true, signal: controller.signal });
    updateSection();
    cleanup = () => { controller.abort(); cancelAnimationFrame(frame); timers.forEach(clearTimeout); };
  }
  setupDocument();
  document.addEventListener("astro:page-load", setupDocument);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
