---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
---
<BaseLayout title={`${frontmatter.title} — Miyuki`} description={frontmatter.description}>
  <article class="article-shell">
    <header class="article-header">
      <a class="back" href="/blog/">← 全部文章</a>
      <div class="article-meta"><span>{frontmatter.tags?.join(" / ")}</span><time>{new Date(frontmatter.pubDate).toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}</time></div>
      <h1>{frontmatter.title}</h1>
      <p>{frontmatter.description}</p>
    </header>
    <div class="article-body"><slot /></div>
    <footer class="article-end"><span>End of note</span><a href="/blog/">继续阅读 →</a></footer>
  </article>
</BaseLayout>
<style is:global>
  .article-shell { width: min(1120px, calc(100% - 48px)); margin: 0 auto; padding: 70px 0 110px; }
  .article-header { max-width: 940px; margin: 0 auto 70px; }
  .article-header .back { display: inline-block; margin-bottom: 54px; border-bottom: 1px solid currentColor; font-size: .7rem; font-weight: 800; text-transform: uppercase; }
  .article-meta { display: flex; justify-content: space-between; gap: 20px; padding-top: 16px; border-top: 1px solid var(--ink); font-family: monospace; font-size: .65rem; text-transform: uppercase; }
  .article-header h1 { max-width: 900px; margin: 38px 0 22px; font-family: var(--serif); font-size: clamp(3.1rem, 7vw, 7rem); font-weight: 400; line-height: .9; letter-spacing: -.05em; }
  .article-header > p { max-width: 640px; margin: 0; color: var(--muted); font-family: var(--serif); font-size: 1.3rem; line-height: 1.55; }
  .article-body { width: min(680px, 100%); margin: 0 auto; color: #292929; font-family: var(--serif); font-size: 1.08rem; line-height: 1.9; }
  .article-body h1 { display: none; }
  .article-body h2 { margin: 2.8em 0 .8em; color: var(--ink); font-family: var(--sans); font-size: 1.45rem; line-height: 1.25; }
  .article-body p { margin: 1.35em 0; }
  .article-body a { border-bottom: 1px solid var(--ink); }
  .article-body img { width: calc(100% + 200px); max-width: none; margin: 2.5em -100px; filter: grayscale(1); }
  .article-body code { padding: .15em .35em; background: #e9e9e6; font-family: monospace; font-size: .85em; }
  .article-body pre { overflow-x: auto; padding: 24px; background: var(--ink); color: var(--white); font-size: .82rem; line-height: 1.65; }
  .article-body pre code { padding: 0; background: none; }
  .article-body blockquote { margin: 2em 0; padding-left: 24px; border-left: 3px solid var(--accent); font-size: 1.25rem; font-style: italic; }
  .article-end { display: flex; justify-content: space-between; width: min(680px, 100%); margin: 80px auto 0; padding-top: 20px; border-top: 1px solid var(--ink); font-size: .69rem; font-weight: 800; text-transform: uppercase; }
  @media (max-width: 720px) {
    .article-shell { width: min(100% - 28px, 1120px); padding: 44px 0 76px; }
    .article-header { margin-bottom: 48px; }
    .article-header .back { margin-bottom: 38px; }
    .article-header h1 { margin-top: 28px; }
    .article-meta { flex-direction: column; gap: 8px; }
    .article-body { font-size: 1rem; }
    .article-body img { width: 100%; margin: 2em 0; }
  }
</style>
