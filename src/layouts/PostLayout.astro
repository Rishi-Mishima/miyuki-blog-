---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
const headings: { depth: number; slug: string; text: string }[] = Astro.props.headings ?? [];
const sections = headings.filter(({ depth }) => depth === 2 || depth === 3);
const date = new Date(frontmatter.pubDate);
const duplicateTitle = headings[0]?.depth === 1 && headings[0]?.text === frontmatter.title;
---
<BaseLayout title={`${frontmatter.title} — Miyuki`} description={frontmatter.description} theme="dark">
  <div class="document-page">
    <article class="article-shell">
      <header class="article-header">
        <a class="back" href="/blog/">← 全部文章</a>
        <div class="article-meta">
          <time datetime={date.toISOString()}>{date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}</time>
          <div class="article-tags">{frontmatter.tags?.map((tag: string) => <span>{tag}</span>)}</div>
        </div>
        <h1>{frontmatter.title}</h1>
        {frontmatter.description && <p>{frontmatter.description}</p>}
      </header>
      {sections.length > 0 && (
        <>
          <details class="mobile-toc">
            <summary>文章目录</summary>
            <nav aria-label="文章目录">
              <ol>{sections.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
            </nav>
          </details>
          <aside class="desktop-toc">
            <nav class="toc-sticky" aria-label="文章目录">
              <h2>文章目录</h2>
              <ol>{sections.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
            </nav>
          </aside>
        </>
      )}
      <div class:list={["article-body", { "duplicate-title": duplicateTitle }]}><slot /></div>
      <footer class="article-end"><span>End of note</span><a href="/blog/">继续阅读 →</a></footer>
      <p class="copy-status" role="status" aria-live="polite" aria-atomic="true"></p>
    </article>
  </div>
</BaseLayout>

<style is:global>
  html:has(.document-page), body:has(.document-page) { background: #080a0e; }
  body:has(.document-page) .site-footer { background: #080a0e; color: #a7afb9; border-color: #28313b; }
  .document-page { background: #080a0e; color: #d0d5dc; min-height: 70vh; }
  .article-shell { position: relative; width: min(760px, calc(100% - 48px)); margin: 0 auto; padding: 56px 0 80px; }
  .article-header { margin-bottom: 48px; }
  .article-header .back { display: inline-flex; padding: 8px 0; margin-bottom: 32px; color: #7ef9ff; font-size: .875rem; }
  .article-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 16px 24px; padding-top: 20px; border-top: 1px solid rgba(126,249,255,.3); box-shadow: 0 -6px 12px -12px #7ef9ff; font-family: var(--mono); font-size: .75rem; color: #a7afb9; }
  .article-tags { display: flex; flex-wrap: wrap; gap: 8px 14px; min-width: 0; }
  .article-tags span { color: #e8a3d0; overflow-wrap: anywhere; }
  .article-tags span::before { content: "#"; color: #bd488f; }
  .article-header h1 { margin: 24px 0 18px; color: #f2f5f8; font-family: var(--sans); font-size: 2.5rem; font-weight: 750; line-height: 1.25; letter-spacing: 0; overflow-wrap: anywhere; }
  .article-header > p { margin: 0; color: #a7afb9; font-size: 1.0625rem; line-height: 1.8; overflow-wrap: anywhere; }
  .article-body { min-width: 0; font-family: var(--sans); font-size: 17px; line-height: 1.8; overflow-wrap: anywhere; }
  .article-body.duplicate-title > h1:first-child { display: none; }
  .article-body :is(h1,h2,h3,h4,h5,h6) { color: #f2f5f8; margin: 2em 0 .75em; font-weight: 700; line-height: 1.4; letter-spacing: 0; scroll-margin-top: 28px; }
  .article-body h1 { font-size: 2rem; }
  .article-body h2 { font-size: 1.5rem; padding-bottom: 10px; border-bottom: 1px solid #232b34; }
  .article-body h3 { font-size: 1.25rem; }
  .article-body :is(h4,h5,h6) { font-size: 1.0625rem; }
  .article-body p { margin: 1.2em 0; }
  .article-body :is(ul,ol) { padding-left: 1.6em; margin: 1.2em 0; }
  .article-body li { padding-left: .25em; margin: .35em 0; }
  .article-body li::marker { color: #7ef9ff; }
  .article-body li > :is(ul,ol) { margin: .4em 0; }
  .article-body strong { color: #f2f5f8; }
  .document-page a { color: #7ef9ff; }
  .article-body a { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: rgba(126,249,255,.4); }
  .document-page a:hover { color: #bafcff; text-shadow: 0 0 10px rgba(126,249,255,.25); }
  .document-page :is(a,button,summary):focus-visible { outline: 2px solid #7ef9ff; outline-offset: 4px; }
  .article-body img { display: block; width: auto; max-width: 100%; height: auto; margin: 2em auto; border-radius: 4px; }
  .article-body :not(pre) > code { padding: .15em .35em; border: 1px solid #30313e; border-radius: 4px; background: #18191f; color: #e8a3d0; font-family: var(--mono); font-size: .875em; box-decoration-break: clone; }
  .article-body pre { max-width: 100%; overflow-x: auto; padding: 22px; margin: 1.5em 0; border: 1px solid rgba(126,249,255,.22); border-radius: 6px; box-shadow: 0 0 14px rgba(126,249,255,.035); font-family: var(--mono); font-size: .875rem; line-height: 1.7; tab-size: 2; }
  .article-body pre code { padding: 0; border: 0; background: none; font: inherit; white-space: pre; overflow-wrap: normal; }
  .article-body blockquote { margin: 1.5em 0; padding: 2px 0 2px 20px; border-left: 2px solid #59cad3; color: #a7afb9; }
  .article-body blockquote > :first-child { margin-top: .5em; }
  .article-body blockquote > :last-child { margin-bottom: .5em; }
  .article-body hr { margin: 2em 0; border: 0; border-top: 1px solid #28313b; }
  .article-body table { display: block; width: max-content; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin: 1.5em 0; font-size: .9375rem; }
  .article-body :is(th,td) { padding: 12px 16px; border: 1px solid #28313b; min-width: 120px; text-align: left; }
  .article-body th { background: #12171c; color: #f2f5f8; }
  .article-body input[type="checkbox"] { accent-color: #7ef9ff; }
  .article-end { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; margin-top: 56px; padding-top: 20px; border-top: 1px solid #28313b; font-family: var(--mono); font-size: .8125rem; color: #a7afb9; }
  .desktop-toc { position: absolute; left: calc(100% + 40px); top: 56px; bottom: 80px; width: 200px; }
  .toc-sticky { position: sticky; top: 28px; max-height: calc(100vh - 56px); overflow-y: auto; padding: 4px 8px 4px 16px; border-left: 1px solid #28313b; }
  .toc-sticky h2 { margin: 0 0 16px; color: #a7afb9; font-size: .8125rem; font-weight: 600; }
  .document-page nav ol { list-style: none; padding: 0; margin: 0; }
  .document-page nav li { margin: 0; }
  .document-page nav .nested { padding-left: 14px; }
  .document-page nav a { display: block; padding: 6px 0; color: #a7afb9; font-size: .8125rem; line-height: 1.6; overflow-wrap: anywhere; }
  .document-page nav a[aria-current="location"] { color: #7ef9ff; }
  .mobile-toc { display: none; margin-bottom: 32px; padding: 14px 0; border-block: 1px solid #28313b; }
  .mobile-toc summary { color: #7ef9ff; font-size: .875rem; cursor: pointer; }
  .mobile-toc nav { margin-top: 12px; }
  .code-block { min-width: 0; margin: 1.5em 0; }
  .code-block pre { margin: 0; border-top-left-radius: 0; border-top-right-radius: 0; }
  .code-toolbar { display: flex; justify-content: flex-end; align-items: center; min-height: 40px; padding: 4px 10px; border: 1px solid rgba(126,249,255,.22); border-bottom: 0; border-radius: 6px 6px 0 0; background: #12171c; }
  .copy-code { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 4px; background: transparent; color: #a7afb9; cursor: pointer; }
  .copy-code:hover { color: #7ef9ff; background: #1d2830; }
  .copy-code:disabled { opacity: .5; }
  .copy-icon { position: relative; display: block; width: 12px; height: 14px; border: 1px solid currentColor; }
  .copy-icon::before { position: absolute; top: -4px; left: -4px; width: 9px; height: 11px; border-top: 1px solid currentColor; border-left: 1px solid currentColor; content: ""; }
  .copy-status { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 1279px) { .desktop-toc { display: none; } .mobile-toc { display: block; } }
  @media (max-width: 720px) {
    .article-shell { width: calc(100% - 32px); padding: 36px 0 56px; }
    .article-header { margin-bottom: 32px; }
    .article-header h1 { font-size: 2rem; }
    .article-body { font-size: 16px; }
    .article-body pre { padding: 16px; font-size: .8125rem; }
  }
  @media (prefers-reduced-motion: reduce) { html:has(.document-page) { scroll-behavior: auto; } }
</style>

<script>
  let cleanup: (() => void) | undefined;
  function setupDocument() {
    cleanup?.();
    const article = document.querySelector<HTMLElement>(".article-shell");
    if (!article) return;
    const controller = new AbortController();
    const timers = new Set<ReturnType<typeof setTimeout>>();
    const status = article.querySelector<HTMLElement>(".copy-status");

    article.querySelectorAll<HTMLPreElement>(".article-body pre").forEach((pre, index) => {
      if (!pre.querySelector("code")) return;
      let wrapper = pre.closest<HTMLElement>(".code-block");
      if (!wrapper) {
        wrapper = document.createElement("div");
        wrapper.className = "code-block";
        const toolbar = document.createElement("div");
        toolbar.className = "code-toolbar";
        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy-code";
        button.title = "复制代码";
        button.setAttribute("aria-label", `复制第 ${index + 1} 段代码`);
        const icon = document.createElement("span");
        icon.className = "copy-icon";
        icon.setAttribute("aria-hidden", "true");
        button.append(icon);
        toolbar.append(button);
        pre.before(wrapper);
        wrapper.append(toolbar, pre);
      }
      const button = wrapper.querySelector<HTMLButtonElement>(".copy-code")!;
      pre.tabIndex = 0;
      pre.setAttribute("aria-label", `第 ${index + 1} 段代码`);
      button.addEventListener("click", async () => {
        if (status) status.textContent = "";
        button.disabled = true;
        try {
          await navigator.clipboard.writeText(pre.querySelector("code")!.textContent ?? "");
          if (controller.signal.aborted) return;
          button.title = "已复制";
          if (status) status.textContent = "代码已复制";
          button.style.color = "#7ef9ff";
        } catch {
          if (controller.signal.aborted) return;
          button.title = "复制失败，请手动选择代码";
          if (status) status.textContent = "复制失败，请手动选择代码";
        } finally {
          button.disabled = false;
        }
        const timer = setTimeout(() => { button.title = "复制代码"; button.style.color = ""; timers.delete(timer); }, 2000);
        timers.add(timer);
      }, { signal: controller.signal });
    });
    article.querySelectorAll<HTMLTableElement>(".article-body table").forEach((table) => {
      table.tabIndex = 0;
      table.setAttribute("aria-label", table.caption?.textContent || "文章表格");
    });

    const headings = Array.from(article.querySelectorAll<HTMLElement>(".article-body h2[id], .article-body h3[id]"));
    const links = Array.from(article.querySelectorAll<HTMLAnchorElement>("nav a[href^='#']"));
    let frame = 0;
    function updateSection() {
      frame = 0;
      let current = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= 100) current = heading;
      }
      for (const link of links) {
        if (current && decodeURIComponent(link.hash.slice(1)) === current.id) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    }
    function scheduleSection() { if (!frame) frame = requestAnimationFrame(updateSection); }
    document.addEventListener("scroll", scheduleSection, { passive: true, signal: controller.signal });
    window.addEventListener("resize", scheduleSection, { passive: true, signal: controller.signal });
    article.addEventListener("load", scheduleSection, { capture: true, signal: controller.signal });
    updateSection();
    cleanup = () => { controller.abort(); cancelAnimationFrame(frame); timers.forEach(clearTimeout); };
  }
  setupDocument();
  document.addEventListener("astro:page-load", setupDocument);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
