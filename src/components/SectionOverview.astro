---
interface SectionItem {
  index: string;
  title: string;
  description: string;
}

interface Props {
  kicker: string;
  meta: string;
  title: string;
  accent: string;
  intro: string;
  items: SectionItem[];
}

const { kicker, meta, title, accent, intro, items } = Astro.props;
---

<section class="inner-page section-overview">
  <div class="page-kicker">
    <p class="eyebrow">{kicker}</p>
    <span>{meta}</span>
  </div>
  <div class="section-hero">
    <div>
      <h1>{title}<br /><em>{accent}</em></h1>
      <p>{intro}</p>
    </div>
    <a class="text-link" href="/blog/">阅读全部文章</a>
  </div>
  <div class="section-grid">
    {items.map((item) => (
      <article>
        <span>{item.index}</span>
        <h2>{item.title}</h2>
        <p>{item.description}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .page-kicker > span {
    font-family: var(--mono);
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .section-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px;
    align-items: end;
    padding: 70px 0 86px;
  }

  .section-hero h1 {
    max-width: 980px;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3.6rem, 8.5vw, 8rem);
    font-weight: 400;
    line-height: 0.86;
    letter-spacing: -0.045em;
  }

  .section-hero h1 em {
    font-weight: 400;
  }

  .section-hero p {
    max-width: 680px;
    margin: 34px 0 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  article {
    min-height: 240px;
    padding: 28px;
    border-right: 1px solid var(--line);
  }

  article:last-child {
    border-right: 0;
  }

  article span {
    font-family: var(--mono);
    font-size: 0.65rem;
  }

  article h2 {
    margin: 54px 0 14px;
    font-family: var(--serif);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1;
  }

  article p {
    margin: 0;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .section-hero {
      grid-template-columns: 1fr;
      gap: 34px;
      padding: 48px 0 64px;
    }

    .section-hero h1 {
      font-size: clamp(3.2rem, 17vw, 5.5rem);
    }

    .section-grid {
      grid-template-columns: 1fr;
    }

    article {
      min-height: 180px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    article:last-child {
      border-bottom: 0;
    }
  }
</style>
