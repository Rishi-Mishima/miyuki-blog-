---
import Navigation from "./Navigation.astro";
interface Props { theme?: "light" | "dark"; }
const { theme = "light" } = Astro.props;
---
<header class:list={["site-header", { dark: theme === "dark" }]}>
  <a class="wordmark" href="/" aria-label="Miyuki 首页"><span class="wordmark-dot"></span>MIYUKI</a>
  <Navigation />
</header>
<style>
  .site-header { position: relative; z-index: 20; display: flex; min-height: 72px; align-items: center; justify-content: space-between; gap: 28px; padding: 0 32px; border-bottom: 1px solid var(--ink); background: var(--paper); }
  .site-header.dark { color: var(--white); border-color: rgba(255,255,255,.35); background: var(--ink); }
  .wordmark { display: inline-flex; flex-shrink: 0; align-items: center; gap: 10px; font-size: 1.125rem; font-weight: 900; letter-spacing: 0; }
  .wordmark-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); border: 1px solid var(--ink); }
  @media (max-width: 720px) { .site-header { min-height: 62px; flex-direction: column; padding: 16px 14px; gap: 12px; } }
</style>
