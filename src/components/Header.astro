---
import Navigation from "./Navigation.astro";
interface Props { theme?: "light" | "dark"; }
const { theme = "light" } = Astro.props;
---
<header class:list={["site-header", { dark: theme === "dark" }]}>
  <a class="wordmark" href="/" aria-label="Miyuki 首页"><span class="wordmark-dot"></span>MIYUKI</a>
  <Navigation />
</header>
<style>
  .site-header { position: relative; z-index: 20; display: flex; width: min(1180px, calc(100% - 96px)); margin: 0 auto; min-height: 80px; align-items: center; justify-content: space-between; gap: 28px; padding: 16px 0; border-bottom: 1px solid var(--line); background: var(--paper); color: var(--ink); }
  .wordmark { display: inline-flex; flex-shrink: 0; align-items: center; gap: 10px; font-family: var(--mono); font-size: .875rem; font-weight: 700; }
  .wordmark-dot { width: 7px; height: 7px; background: var(--accent); box-shadow: 0 0 8px #c2ff6230; }
  @media (max-width: 900px) { .site-header { flex-wrap: wrap; gap: 16px; } }
  @media (max-width: 760px) { .site-header { width: calc(100% - 40px); gap: 12px; padding: 20px 0; } }
</style>
