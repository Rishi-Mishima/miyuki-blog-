---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "./PostList.astro";
import { navigationLinks } from "../config/navigation";
import { posts } from "../data/posts";
import { postCategories } from "../config/post-categories";
const currentPath = `${Astro.url.pathname.replace(/\/$/, "")}/`;
const section = navigationLinks.find((link) => link.href === currentPath);
const title = section?.label ?? "全部文章";
const category = postCategories.find(({ href }) => href === currentPath);
const visiblePosts = category ? posts.filter((post) => post.category === category.id) : posts;
---
<BaseLayout title={`${title} — Miyuki`} description="Miyuki 关于软件、AI 与个人系统的文章。" theme="dark">
  <section class="inner-page archive">
    <div class="page-kicker"><p class="eyebrow">~/miyuki{currentPath}</p><span>{String(visiblePosts.length).padStart(2, "0")} notes / latest first</span></div>
    <header class="archive-header"><h1>{title}<span>.</span></h1><p>关于软件、AI 与个人系统。<br />把构建的过程和想法，慢慢写下来。</p></header>
    <nav class="archive-categories" aria-label="文章分类">
      <a href="/blog/" aria-current={currentPath === "/blog/" ? "page" : undefined}>全部</a>
      {postCategories.map((item) => <a href={item.href} aria-current={item.href === currentPath ? "page" : undefined}>{item.label}</a>)}
    </nav>
    <h2 class="eyebrow list-label">文章 / Notes</h2>
    <PostList posts={visiblePosts} />
  </section>
</BaseLayout>
<style>
  .archive-header { display: flex; flex-wrap: wrap; gap: 24px 56px; align-items: end; justify-content: space-between; padding: 56px 0 64px; }
  h1 { max-width: 780px; margin: 0; font-size: 3.75rem; font-weight: 550; line-height: 1.25; overflow-wrap: anywhere; }
  h1 span { color: var(--accent); }
  .archive-header p { margin: 0; color: var(--muted); font-size: .875rem; line-height: 1.8; }
  .list-label { margin-bottom: 20px; }
  .archive-categories { display: flex; flex-wrap: wrap; gap: 12px 28px; margin-bottom: 32px; border-bottom: 1px solid var(--line); }
  .archive-categories a { padding: 12px 0; border-bottom: 2px solid transparent; color: var(--muted); font-size: .875rem; }
  .archive-categories a:hover, .archive-categories a[aria-current="page"] { color: var(--accent); border-bottom-color: var(--accent); }
  @media (max-width: 760px) { .archive-header { padding: 32px 0 40px; } h1 { font-size: 2.25rem; } }
</style>
