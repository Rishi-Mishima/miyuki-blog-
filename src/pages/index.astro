---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopicExplorer from "../components/TopicExplorer.jsx";
import PostList from "../components/PostList.astro";
import ContactLinks from "../components/ContactLinks.astro";
import { navigationLinks } from "../config/navigation";
import { posts } from "../data/posts";
import { ArrowDown, ArrowUpRight } from "@lucide/astro";
const directoryMeta = ["code / systems / learning", "models / agents / experiments", "finance / business / curiosity", "biomed / IR / a little more"];
---
<BaseLayout title="Miyuki — Ideas, Systems & Code" description="关于软件、AI 与生活系统的个人研究档案。" theme="dark">
  <div class="home-shell">
    <div class="reading-progress" aria-hidden="true"></div>
    <section class="identity" aria-labelledby="identity-title">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="identity-top"><p class="eyebrow">Personal archive / 个人研究档案</p><div class="hero-status"><span class="status-dot" aria-hidden="true"></span><span>Amsterdam, NL</span><button class="motion-toggle" type="button" aria-pressed="false">暂停动效</button></div></div>
      <div class="identity-main">
        <div class="identity-copy">
          <p class="hello"><span aria-hidden="true">↳</span> A curious mind, always building.</p>
          <h1 id="identity-title">Miyuki<span>.</span><span class="title-outline" aria-hidden="true">Miyuki.</span></h1>
          <p class="statement">Rooted in Biomed &amp; IR.<br />Driven by Code &amp; Business.</p>
          <p class="welcome-note">你好，欢迎来到我的数字工作台。<br />在这里记录学习、分享实验，也收集一点好奇心。</p>
          <div class="hero-actions"><a class="about-button" href="/about/">认识一下我 <ArrowUpRight size={16} aria-hidden="true" /></a><a class="text-link" href="/blog/">读读笔记 <ArrowUpRight size={16} aria-hidden="true" /></a></div>
        </div>
        <figure class="portrait">
          <div class="portrait-orbit" aria-hidden="true"><span class="orbit-dot"></span></div><span class="portrait-label" aria-hidden="true">FIG. 01 / THE HUMAN</span><div class="portrait-frame">
          <img src="/images/miyuki-portrait.jpg" alt="粉色背景的动漫人物侧脸，Miyuki 的个人头像" width="560" height="581" fetchpriority="high" />
          </div><span class="portrait-coordinate" aria-hidden="true">52° N / 04° E</span><figcaption>FINANCE <span>/</span> AI <span>/</span> SYSTEMS</figcaption>
        </figure>
      </div>
      <div class="identity-bottom"><p>关于软件、AI 与生活系统的个人研究档案。</p><a href="#directory" class="text-link">探索档案 <ArrowDown size={16} aria-hidden="true" /></a></div>
    </section>

    <div class="archive-summary" aria-label="博客概况"><span><strong>{posts.length.toString().padStart(2, "0")}</strong> 篇笔记 / Notes</span><span><strong>03</strong> 个探索方向 / Topics</span><a href="/about/#profile">Biomed &amp; IR → Code &amp; AI <ArrowUpRight size={14} aria-hidden="true" /></a></div>

    <section class="explorer-section" aria-labelledby="explorer-title" data-reveal>
      <div class="section-heading"><div><p class="eyebrow">01 / Curiosity console</p><h2 id="explorer-title">下一站，探索什么<span>？</span></h2></div><p class="section-note">沿着兴趣，打开一个新的问题。</p></div>
      <TopicExplorer client:visible={{ rootMargin: "400px" }} posts={posts.map((post) => ({ url: post.url, title: post.title, category: post.category, date: post.date.toISOString().slice(0, 10) }))} />
    </section>

    <section class="directory-section" id="directory" aria-labelledby="directory-title">
      <div class="directory-intro"><p class="eyebrow">02 / Directory</p><h2 id="directory-title">想法有了<br /><em>自己的路径。</em></h2><p>学习、实验与持续构建。<br />这是我的数字工作台。</p><span class="terminal-prompt" aria-hidden="true">~/miyuki <span>$_</span></span><div class="directory-position" aria-hidden="true"><span class="directory-current">01</span><span>/ {String(navigationLinks.length).padStart(2, "0")}</span><div class="directory-progress"><span></span></div></div></div>
      <nav class="directory" aria-label="内容目录">
        {navigationLinks.map((link, index) => (
          <a href={link.href} class="directory-row" data-directory-index={index}>
            <span class="branch" aria-hidden="true">{index === navigationLinks.length - 1 ? "└" : "├"}─</span>
            <div><span class="directory-path">{link.href.slice(1)}</span><h3>{link.label}</h3><p>{directoryMeta[index]}</p></div>
            <ArrowUpRight size={24} stroke-width={1.4} aria-hidden="true" />
          </a>
        ))}
      </nav>
    </section>

    <section data-reveal class="recent-section" aria-labelledby="recent-title">
      <div class="section-heading"><div><p class="eyebrow">03 / Writing</p><h2 id="recent-title">写作与研究。</h2></div><a href="/blog/" class="text-link">全部文章 <ArrowUpRight size={16} aria-hidden="true" /></a></div>
      <p class="notes-label">最新文章</p>
      <PostList posts={posts.slice(0, 3)} />
    </section>

    <section data-reveal class="connect-section" aria-labelledby="connect-title">
      <div><p class="eyebrow">04 / Elsewhere</p><h2 id="connect-title">继续交流。</h2></div>
      <ContactLinks />
    </section>
  </div>
</BaseLayout>
<script>
  const home = document.querySelector<HTMLElement>(".home-shell");
  const hero = document.querySelector<HTMLElement>(".identity");
  const toggle = document.querySelector<HTMLButtonElement>(".motion-toggle");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let paused = reducedMotion.matches;
  const syncMotion = () => {
    if (home) home.dataset.motion = paused ? "paused" : "running";
    toggle?.setAttribute("aria-pressed", String(paused));
    if (toggle) toggle.textContent = paused ? "开启动效" : "暂停动效";
    if (paused) { hero?.style.removeProperty("--pointer-x"); hero?.style.removeProperty("--pointer-y"); }
  };
  toggle?.addEventListener("click", () => { paused = !paused; syncMotion(); });
  reducedMotion.addEventListener("change", () => { paused = reducedMotion.matches; syncMotion(); });
  syncMotion();
  let pointerFrame = 0;
  hero?.addEventListener("pointermove", (event) => {
    if (paused || event.pointerType !== "mouse" || pointerFrame) return;
    pointerFrame = requestAnimationFrame(() => {
      const rect = hero.getBoundingClientRect();
      hero.style.setProperty("--pointer-x", `${(event.clientX - rect.left) / rect.width * 100}%`);
      hero.style.setProperty("--pointer-y", `${(event.clientY - rect.top) / rect.height * 100}%`);
      pointerFrame = 0;
    });
  }, { passive: true });
  hero?.addEventListener("pointerleave", () => { hero.style.removeProperty("--pointer-x"); hero.style.removeProperty("--pointer-y"); });
  const updateProgress = () => {
    const total = document.documentElement.scrollHeight - innerHeight;
    home?.style.setProperty("--reading-progress", String(total > 0 ? Math.min(1, Math.max(0, scrollY / total)) : 0));
  };
  let progressFrame = 0;
  const scheduleProgress = () => { if (!progressFrame) progressFrame = requestAnimationFrame(() => { updateProgress(); progressFrame = 0; }); };
  window.addEventListener("scroll", scheduleProgress, { passive: true });
  window.addEventListener("resize", scheduleProgress);
  updateProgress();
  if ("IntersectionObserver" in window && !reducedMotion.matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add("is-visible"); observer.unobserve(entry.target); } });
    }, { threshold: .08 });
    document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((element) => { element.classList.add("reveal-ready"); observer.observe(element); });
  }
  const section = document.querySelector<HTMLElement>("#directory");
  if (section) {
    const rows = [...section.querySelectorAll<HTMLElement>(".directory-row")];
    const current = section.querySelector<HTMLElement>(".directory-current");
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let scheduled = false;

    const update = () => {
      scheduled = false;
      const focusLine = window.innerHeight * 0.48;
      let active = 0;
      let nearest = Infinity;
      rows.forEach((row, index) => {
        const rect = row.getBoundingClientRect();
        const distance = Math.abs(rect.top + rect.height / 2 - focusLine);
        if (distance < nearest) {
          nearest = distance;
          active = index;
        }
        const offset = (motion.matches || paused) ? 0 : Math.max(-12, Math.min(12, (rect.top - focusLine) * 0.035));
        row.style.setProperty("--scroll-offset", `${offset}px`);
      });
      rows.forEach((row, index) => row.classList.toggle("is-active", index === active));
      if (current) current.textContent = String(active + 1).padStart(2, "0");
      section.style.setProperty("--directory-progress", String((active + 1) / rows.length));
    };

    const schedule = () => {
      if (!scheduled) {
        scheduled = true;
        window.requestAnimationFrame(update);
      }
    };
    section.classList.add("scroll-ready");
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    motion.addEventListener("change", schedule);
    toggle?.addEventListener("click", schedule);
    update();
  }
</script>
<style>
  .home-shell { width: min(1180px, calc(100% - 96px)); margin: 0 auto; }
  .identity { padding: 32px 0 24px; }
  .identity-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; }
  .identity-top > span { color: var(--muted); font: .6875rem var(--mono); }
  .identity-main { display: grid; grid-template-columns: minmax(0, 1fr) 330px; align-items: center; gap: 36px; padding: 40px 0 36px; }
  .hello { margin: 0 0 12px; color: var(--muted); font: .875rem var(--mono); }
  h1 { margin: 0; font-size: 144px; font-weight: 600; line-height: 1; }
  h1 span { color: var(--accent); }
  .statement { margin: 28px 0 0; font-size: 1.5rem; line-height: 1.55; font-weight: 450; }
  .welcome-note { margin: 20px 0 0; color: var(--muted); font-size: .875rem; line-height: 1.9; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 24px; }
  .about-button { display: inline-flex; align-items: center; gap: 24px; padding: 12px 18px; background: var(--accent); color: var(--paper); font-size: .8125rem; border: 1px solid var(--accent); }
  .about-button:hover { background: var(--paper); color: var(--accent); }
  .archive-summary { display: flex; flex-wrap: wrap; align-items: center; gap: 20px 40px; margin-top: 24px; padding: 24px 0; border-top: 1px solid var(--line); color: var(--muted); font: .6875rem/1.8 var(--mono); }
  .archive-summary strong { margin-right: 8px; color: var(--ink); font-size: 1.125rem; font-weight: 400; }
  .archive-summary a { display: inline-flex; align-items: center; gap: 12px; margin-left: auto; color: var(--cyan); }
  .archive-summary a:hover { color: var(--accent); }
  @media (max-width: 760px) { .archive-summary { gap: 12px 24px; } .archive-summary a { width: 100%; margin-left: 0; } }
  .portrait { width: 330px; margin: 0; }
  .portrait img { width: 100%; aspect-ratio: 560 / 581; object-fit: contain; }
  figcaption { margin-top: 12px; color: var(--muted); text-align: center; font: .6875rem var(--mono); }
  figcaption span { margin: 0 8px; color: var(--pink); }
  .identity-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; }
  .identity-bottom p { margin: 0; color: var(--muted); font-size: .875rem; line-height: 1.8; }
  .directory-section { display: grid; grid-template-columns: 1fr 1.8fr; gap: 72px; padding: 48px 0 64px; border-top: 1px solid var(--line); scroll-margin-top: 24px; }
  .directory-intro { position: sticky; top: 48px; align-self: start; }
  .directory-intro h2 { margin: 24px 0; font-size: 2.25rem; font-weight: 500; line-height: 1.45; }
  .directory-intro h2 em { color: var(--accent); font-family: var(--serif); font-style: normal; }
  .directory-intro > p:last-of-type { color: var(--muted); font-size: .875rem; line-height: 1.8; }
  .terminal-prompt { display: block; margin-top: 38px; color: var(--muted); font: .75rem var(--mono); }
  .terminal-prompt > span { color: var(--accent); }
  .directory-position { display: flex; align-items: baseline; gap: 12px; margin-top: 32px; max-width: 240px; color: var(--muted); font: .75rem var(--mono); }
  .directory-current { color: var(--ink); font-size: 2rem; }
  .directory-progress { flex: 1; height: 2px; background: var(--line); align-self: center; margin-left: 12px; overflow: hidden; }
  .directory-progress > span { display: block; height: 100%; background: var(--accent); transform-origin: left; transform: scaleX(var(--directory-progress, .25)); transition: transform .35s ease; }
  .directory { border-top: 1px solid var(--line); }
  .directory-row { display: grid; grid-template-columns: 28px minmax(0, 1fr) 24px; align-items: center; gap: 24px; min-height: 210px; padding: 32px 12px; border-bottom: 1px solid var(--line); transition: background .25s ease, border-color .25s ease, opacity .25s ease; }
  .scroll-ready .directory-row { opacity: .55; }
  .scroll-ready .directory-row > div { transform: translateY(var(--scroll-offset, 0px)); }
  .scroll-ready .directory-row.is-active, .scroll-ready .directory-row:hover, .scroll-ready .directory-row:focus-visible { opacity: 1; border-bottom-color: var(--accent); }
  .directory-row.is-active .directory-path { color: var(--accent); }
  .directory-row:hover, .directory-row:focus-visible { background: var(--surface); border-color: var(--accent); }
  .branch { align-self: start; margin-top: 8px; color: var(--accent); font: 1rem var(--mono); }
  .directory-path { color: var(--muted); font: .6875rem var(--mono); }
  .directory-row h3 { margin: 8px 0 10px; font-size: 1.375rem; line-height: 1.45; font-weight: 500; overflow-wrap: anywhere; }
  .directory-row p { margin: 0; color: var(--cyan); font: .6875rem/1.6 var(--mono); overflow-wrap: anywhere; }
  .directory-row svg { color: var(--accent); transition: transform .18s ease; }
  .directory-row:hover svg { transform: translate(3px, -3px); }
  .recent-section { padding: 56px 0 64px; border-top: 1px solid var(--line); }
  .notes-label { margin: 32px 0 16px; color: var(--muted); font-size: .75rem; }
  .connect-section { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; padding: 40px 0 56px; border-top: 1px solid var(--line); }
  .connect-section h2 { margin: 16px 0 0; font-size: 1.75rem; font-weight: 500; }
  @media (max-width: 1100px) {
    h1 { font-size: 112px; }
    .identity-main { grid-template-columns: minmax(0, 1fr) 260px; }
    .portrait { width: 260px; }
    .directory-section { gap: 40px; }
  }
  @media (max-width: 760px) {
    .home-shell { width: calc(100% - 40px); }
    .identity { padding-top: 24px; }
    .identity-main { position: relative; display: block; padding: 30px 0 22px; }
    .hello { font-size: .75rem; }
    h1 { font-size: 76px; }
    .statement { font-size: 1.0625rem; margin-top: 20px; }
    .portrait { width: 170px; margin: 16px 0 0 auto; }
    figcaption { font-size: .5625rem; }
    figcaption span { margin: 0 4px; }
    .identity-bottom { align-items: start; }
    .identity-bottom p { max-width: 240px; font-size: .8125rem; }
    .directory-section { grid-template-columns: 1fr; gap: 24px; padding: 32px 0 40px; }
    .directory-intro { position: static; }
    .directory-position { margin-top: 20px; max-width: none; }
    .directory-intro h2 { margin: 16px 0; font-size: 1.75rem; }
    .directory-intro h2 br { display: none; }
    .directory-intro > p:last-of-type, .terminal-prompt { display: none; }
    .directory-row { gap: 12px; min-height: 180px; padding: 22px 0; grid-template-columns: 20px minmax(0, 1fr) 24px; }
    .directory-row h3 { font-size: 1.125rem; }
    .recent-section { padding: 40px 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-ready .directory-row { opacity: 1; }
    .scroll-ready .directory-row > div { transform: none; }
  }
  @media (max-width: 359px) { h1 { font-size: 64px; } }
  @media (max-width: 760px) and (max-height: 680px) {
    .identity { padding-top: 16px; }
    .identity-top > span { display: none; }
    .identity-main { padding: 12px 0; }
    .statement { margin-top: 12px; }
    .portrait { width: 80px; margin-top: 0; }
    figcaption { display: none; }
    .identity-bottom { gap: 4px; }
    .identity-bottom p { max-width: none; font-size: .75rem; line-height: 1.6; }
  }

  .reading-progress { position: fixed; z-index: 50; top: 0; left: 0; width: 100%; height: 2px; background: var(--accent); transform-origin: left; transform: scaleX(var(--reading-progress, 0)); pointer-events: none; }
  .identity { position: relative; isolation: isolate; overflow: clip; padding-top: 28px; }
  .identity::before { content: ""; position: absolute; z-index: -1; inset: 0 -32px; pointer-events: none; background: radial-gradient(ellipse at var(--pointer-x, 76%) var(--pointer-y, 48%), #c2ff6210, transparent 52%); }
  .hero-grid { position: absolute; z-index: -1; inset: 50px -32px 0; pointer-events: none; background-image: linear-gradient(#ffffff05 1px, transparent 1px), linear-gradient(90deg, #ffffff05 1px, transparent 1px); background-size: 56px 56px; mask-image: linear-gradient(90deg, transparent 15%, black 80%); }
  .identity-top { align-items: center; }
  .hero-status { display: flex; align-items: center; gap: 10px; color: var(--muted); font: .625rem var(--mono); }
  .status-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px #c2ff6270; }
  .motion-toggle { margin-left: 12px; padding: 7px 10px; border: 1px solid var(--line); color: var(--muted); background: var(--paper); cursor: pointer; font-size: .625rem; }
  .motion-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .identity-main { padding: 72px 0 64px; grid-template-columns: minmax(0, 1fr) 360px; gap: 48px; }
  .hello { font-size: .6875rem; letter-spacing: .03em; }
  .hello > span { color: var(--accent); margin-right: 8px; }
  h1 { position: relative; width: fit-content; font-size: clamp(96px, 12vw, 160px); letter-spacing: -.075em; font-weight: 600; }
  h1 .title-outline { position: absolute; top: 5px; left: 4px; z-index: -1; color: transparent; -webkit-text-stroke: 1px #c2ff6238; }
  .statement { font-size: 1.25rem; line-height: 1.65; }
  .portrait { position: relative; width: 100%; padding: 28px; }
  .portrait-frame { position: relative; border: 1px solid #e8a5c94d; padding: 10px; background: #e8a5c90a; transform: rotate(-5deg); transition: transform .6s ease, box-shadow .6s ease; }
  .portrait-frame::before, .portrait-frame::after { content: "+"; position: absolute; color: var(--pink); font: 20px var(--mono); line-height: 1; }
  .portrait-frame::before { top: -11px; left: -7px; }
  .portrait-frame::after { bottom: -9px; right: -7px; }
  .portrait:hover .portrait-frame { transform: rotate(0deg) translateY(-5px); box-shadow: 0 12px 60px #e8a5c914; }
  .portrait img { aspect-ratio: 1; object-fit: cover; filter: saturate(.8); }
  .portrait-orbit { position: absolute; inset: -4px; border: 1px solid #c2ff622e; border-radius: 50%; animation: orbit-turn 32s linear infinite; pointer-events: none; }
  .portrait-orbit::after { content: ""; position: absolute; inset: 22px -16px; border: 1px dashed #ffffff12; border-radius: 50%; transform: rotate(35deg); }
  .orbit-dot { position: absolute; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); top: 14%; left: 14%; box-shadow: 0 0 20px #c2ff6280; }
  .portrait-label, .portrait-coordinate { position: absolute; font: .5625rem var(--mono); color: var(--muted); letter-spacing: .08em; }
  .portrait-label { top: -22px; right: 6px; }
  .portrait-coordinate { bottom: 5px; left: -8px; writing-mode: vertical-rl; transform: rotate(180deg); }
  figcaption { margin-top: 28px; font-size: .5625rem; letter-spacing: .15em; }
  .identity-copy { animation: hero-enter .8s ease both; }
  .portrait { animation: hero-enter 1s .15s ease both; }
  .about-button { transition: box-shadow .25s, background .25s, color .25s; }
  .about-button:hover { box-shadow: 0 0 32px #c2ff6226; }
  .explorer-section { padding: 64px 0 72px; border-top: 1px solid var(--line); }
  .section-heading h2 > span { color: var(--accent); }
  .section-note { margin: 0; color: var(--muted); font-size: .8125rem; line-height: 1.8; }
  .directory-row { min-height: 170px; position: relative; overflow: hidden; }
  .directory-row::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, #c2ff6209, transparent); transform: translateX(-100%); transition: transform .5s; }
  .directory-row:hover::before { transform: translateX(0); }
  .reveal-ready { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
  .reveal-ready.is-visible { opacity: 1; transform: none; }
  .home-shell[data-motion="paused"] .portrait-orbit { animation-play-state: paused; }
  .home-shell[data-motion="paused"] .portrait, .home-shell[data-motion="paused"] .identity-copy { animation: none; }
  .home-shell[data-motion="paused"] .reveal-ready { opacity: 1; transform: none; transition: none; }
  .home-shell[data-motion="paused"] .portrait-frame, .home-shell[data-motion="paused"] .directory-row::before { transition: none; transform: none; }
  .home-shell[data-motion="paused"] .directory-row > div { transform: none; }
  @keyframes orbit-turn { to { transform: rotate(360deg); } }
  @keyframes hero-enter { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (max-width: 1100px) { .identity-main { grid-template-columns: minmax(0, 1fr) 280px; gap: 28px; } }
  @media (max-width: 760px) {
    .identity-main { display: grid; grid-template-columns: 1fr; padding: 40px 0 28px; gap: 48px; }
    h1 { font-size: clamp(76px, 19vw, 116px); }
    .hero-status { gap: 8px; }
    .motion-toggle { margin-left: 4px; }
    .statement { font-size: 1.0625rem; }
    .portrait { width: min(250px, 75%); margin: 0 auto 12px; padding: 22px; }
    .portrait-label { top: -12px; font-size: .5rem; }
    .portrait-coordinate { font-size: .5rem; }
    .portrait-orbit { inset: 0; }
    figcaption { display: block; font-size: .5rem; }
    .hero-grid { inset-inline: -12px; }
    .identity::before { inset-inline: -12px; }
    .explorer-section { padding: 40px 0; }
    .directory-row { min-height: 160px; }
  }
  @media (prefers-reduced-motion: reduce) { .reveal-ready { opacity: 1; transform: none; } }
</style>
