---
import BaseLayout from "../layouts/BaseLayout.astro";
const posts = Object.values(import.meta.glob("./posts/*.md", { eager: true }));
const recentPosts = posts.sort((a: any, b: any) => new Date(b.frontmatter.pubDate).valueOf() - new Date(a.frontmatter.pubDate).valueOf()).slice(0, 3);
---
<BaseLayout title="Miyuki — Ideas, Systems & Code" description="关于软件、AI 与生活系统的个人研究档案。" showFooter={false} showHeader={false}>
  <section class="hero">
    <div class="hero-sky"></div>

    <nav class="home-nav" aria-label="首页导航">
      <a href="/blog/">从零手写大模型</a>
      <a href="/blog/">半导体投研</a>
      <a href="/blog/">大模型实验室</a>
      <a href="/about/">关于我</a>
    </nav>

    <aside class="now-panel" id="now">
      <div>
        <p class="eyebrow">最近在做</p>
      </div>
      <div class="project-block">
        <p class="status"><span></span> 两个系列均已完结</p>
        <h2>从零手写大模型</h2>
        <p>推理篇 15 期 · 训练篇 5 期<br />从模型推理到训练基础，全部完结</p>
        <a class="text-link" href="/blog/">查看系列</a>
      </div>
    </aside>

    <div class="identity">
      <div class="portrait-wrap" aria-label="个人照片位置"><span>M</span></div>
      <div class="statement">
        <h1>Biomed &amp; IR but devoted to<br />Computer Science and Business</h1>
        <div class="identity-meta"><span>FINANCE</span><i></i><span>AI</span><i></i><span>SYSTEMS</span></div>
        <div class="socials"><a href="#" aria-label="X">X</a><a href="#" aria-label="GitHub">GH</a></div>
      </div>
    </div>

    <aside class="updates-panel">
      <div class="panel-heading"><p class="eyebrow">最近更新</p></div>
      <div class="updates-list">
        {recentPosts.map((post: any, index) => (
          <a class="update" href={post.url}>
            <div><h2>{post.frontmatter.title}</h2><p>{post.frontmatter.description}</p></div>
          </a>
        ))}
      </div>
    </aside>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; display: grid; height: 100svh; min-height: 0; grid-template-columns: 29% 42% 29%; overflow: hidden; background: #fff; }
  .hero-sky { position: absolute; inset: 0; background: linear-gradient(118deg, #000 0%, #171717 45%, #000 72%); background-size: 200% 200%; clip-path: polygon(0 0, 39% 0, 61% 100%, 0 100%); pointer-events: none; animation: sky-enter 1.15s cubic-bezier(.2,.8,.2,1) both, sky-flow 8s ease-in-out 1.15s infinite alternate; }
  .home-nav { --nav-offset: -50%; position: absolute; top: clamp(26px, 4.5vh, 48px); left: 50%; z-index: 10; display: flex; width: min(680px, 56vw); align-items: center; justify-content: space-between; transform: translateX(var(--nav-offset)); }
  .home-nav a { position: relative; padding: 6px 0; color: #111; font-size: clamp(.72rem, 1vw, .94rem); font-weight: 700; }
  .home-nav a:first-child { color: #fff; }
  .home-nav a::after { position: absolute; right: 0; bottom: 0; left: 0; height: 1px; background: currentColor; content: ""; transform: scaleX(0); transition: transform .2s ease; }
  .home-nav a:hover::after { transform: scaleX(1); }
  .home-nav { animation: nav-in .8s ease .25s both; }
  .now-panel, .updates-panel, .identity { position: relative; z-index: 2; }
  .now-panel { display: flex; height: 100%; min-height: 0; flex-direction: column; justify-content: center; gap: clamp(28px, 5vh, 52px); padding: 0 28px 0 clamp(36px, 6vw, 96px); color: #fff; }
  .now-panel > div:first-child { color: #929292; }
  .status { display: flex; align-items: center; gap: 16px; margin: 0 0 22px -28px; color: #bdbdbd; font-size: .78rem; }
  .status span { width: 10px; height: 10px; flex: 0 0 auto; border: 2px solid #fff; border-radius: 50%; box-shadow: 0 0 0 6px rgba(255,255,255,.08); }
  .project-block { width: min(310px, 92%); margin: 0; padding-left: 28px; border-left: 1px solid #424242; }
  .project-block h2 { margin: 0 0 16px; font-family: var(--sans); font-size: clamp(1.4rem, 2.1vw, 2rem); font-weight: 750; letter-spacing: 0; }
  .project-block p { margin: 0 0 clamp(20px, 3vh, 30px); color: #999; font-size: .84rem; line-height: 1.8; }
  .identity { display: flex; align-items: center; justify-content: center; min-width: 0; }
  .portrait-wrap { position: absolute; top: 15%; left: 50%; display: grid; width: min(27vw, 44vh, 380px); aspect-ratio: 4 / 5; place-items: center; overflow: hidden; background: radial-gradient(circle at 50% 40%, #f1f1f1 0 48%, transparent 70%); transform: translateX(-50%); -webkit-mask-image: linear-gradient(#000 72%, transparent 100%); mask-image: linear-gradient(#000 72%, transparent 100%); }
  .portrait-wrap span { font-family: var(--serif); font-size: clamp(9rem, 17vw, 15rem); font-style: italic; line-height: 1; }
  .statement { position: absolute; bottom: 10%; left: 50%; z-index: 4; width: min(900px, 78vw); color: #fff; text-align: center; transform: translateX(-50%); }
  .statement h1 { margin: 0; color: #fff; font-family: var(--sans); font-size: clamp(2rem, 2.8vw, 3rem); font-weight: 850; line-height: 1.04; letter-spacing: 0; -webkit-text-stroke: 1px #111; }
  .identity-meta { display: flex; width: 100%; align-items: center; justify-content: center; gap: 14px; margin-top: clamp(20px, 3vh, 32px); color: #fff; font-family: monospace; font-size: .78rem; font-weight: 800; letter-spacing: .2em; -webkit-text-stroke: .4px #111; }
  .identity-meta i { width: 3px; height: 3px; border-radius: 50%; background: currentColor; }
  .socials { display: flex; width: 100%; align-items: center; justify-content: center; gap: 36px; margin-top: clamp(28px, 5vh, 54px); }
  .socials a { font-family: var(--sans); font-size: 1rem; font-weight: 850; }
  .updates-panel { z-index: 5; align-self: center; max-height: 70vh; margin: 8vh 30px 0 0; overflow: hidden; border: 1px solid #d2d2d2; border-radius: 8px; background: rgba(255,255,255,.92); }
  .panel-heading { display: flex; align-items: center; justify-content: space-between; padding: 24px 28px 10px; color: #777; }
  .panel-heading span { font-family: var(--serif); font-size: .8rem; }
  .update { display: block; padding: clamp(12px, 2vh, 18px) 28px; transition: background .2s ease; }
  .update:hover { background: #f1f1f1; }
  .update h2 { margin: 0 0 5px; font-family: var(--sans); font-size: clamp(.9rem, 1.15vw, 1.2rem); font-weight: 500; line-height: 1.3; }
  .update p { display: -webkit-box; overflow: hidden; margin: 0; color: var(--muted); font-size: .69rem; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .arrow { align-self: center; font-size: 1rem; }

  .now-panel > div:first-child { animation: rise-in .8s ease .55s both; }
  .project-block { animation: rise-in .9s ease .8s both; }
  .coordinates { animation: rise-in .8s ease 1s both; }
  .issue { animation: reveal-center .8s ease .65s both; }
  .portrait-wrap { animation: portrait-in 1.05s cubic-bezier(.2,.75,.2,1) .75s both; }
  .statement > p { animation: rise-in .75s ease 1.05s both; }
  .statement h1 { animation: rise-in 1.15s cubic-bezier(.2,.75,.2,1) 1.15s both; }
  .identity-meta { animation: rise-in .8s ease 1.5s both; }
  .updates-panel { animation: panel-in .9s cubic-bezier(.2,.75,.2,1) 1.1s both; }

  @keyframes sky-enter { from { transform: translateX(-110%); } to { transform: translateX(0); } }
  @keyframes sky-flow { from { background-position: 0% 40%; } to { background-position: 100% 60%; } }
  @keyframes soft-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes rise-in { from { opacity: 0; filter: blur(7px); transform: translateY(22px); } to { opacity: 1; filter: blur(0); transform: translateY(0); } }
  @keyframes reveal-center { from { opacity: 0; filter: blur(5px); transform: translate(-50%, 15px); } to { opacity: 1; filter: blur(0); transform: translate(-50%, 0); } }
  @keyframes portrait-in { from { opacity: 0; transform: translate(-50%, 24px) scale(.96); } to { opacity: 1; transform: translate(-50%, 0) scale(1); } }
  @keyframes panel-in { from { opacity: 0; transform: translateX(28px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes nav-in { from { opacity: 0; filter: blur(5px); transform: translate(var(--nav-offset), 16px); } to { opacity: 1; filter: blur(0); transform: translate(var(--nav-offset), 0); } }

  @media (max-width: 900px) {
    .hero { display: flex; height: auto; min-height: 0; flex-direction: column; }
    .hero-sky { display: none; }
    .home-nav { --nav-offset: -50%; top: 22px; left: 50%; width: calc(100% - 32px); transform: translateX(var(--nav-offset)); }
    .home-nav a { font-size: clamp(.62rem, 2.2vw, .78rem); }
    .home-nav a:first-child { color: #111; }
    .identity { order: 1; min-height: 660px; background: #fff; }
    .portrait-wrap { top: 12%; width: min(68vw, 290px); }
    .statement { right: auto; bottom: 48px; left: 50%; width: calc(100% - 28px); color: #111; transform: translateX(-50%); }
    .statement h1 { color: #111; font-size: clamp(2rem, 9vw, 3.5rem); line-height: 1.02; -webkit-text-stroke: 0; }
    .identity-meta { margin-top: 18px; color: #111; -webkit-text-stroke: 0; }
    .socials { margin-top: 28px; }
    .now-panel { order: 2; min-height: 500px; padding: 70px 28px; background: #000; }
    .project-block { margin: 0; }
    .updates-panel { order: 3; max-height: none; margin: 0; border-width: 1px 0 0; border-radius: 0; background: #fff; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-sky, .home-nav, .now-panel > div:first-child, .project-block, .portrait-wrap, .statement h1, .identity-meta, .updates-panel { animation: none; }
  }
</style>
