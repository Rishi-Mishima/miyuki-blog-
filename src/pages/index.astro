---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import ContactLinks from "../components/ContactLinks.astro";
import { navigationLinks } from "../config/navigation";
import { posts } from "../data/posts";
import { ArrowDown, ArrowUpRight } from "@lucide/astro";
const directoryMeta = ["code / systems / learning", "models / agents / experiments", "finance / business / curiosity", "biomed / IR / a little more"];
---
<BaseLayout title="Miyuki — Ideas, Systems & Code" description="关于软件、AI 与生活系统的个人研究档案。" theme="dark">
  <div class="home-shell">
    <section class="identity" aria-labelledby="identity-title">
      <div class="identity-top"><p class="eyebrow">Personal archive / 个人研究档案</p><span>Amsterdam, NL</span></div>
      <div class="identity-main">
        <div class="identity-copy">
          <p class="hello">Hi, I'm</p>
          <h1 id="identity-title">Miyuki<span>.</span></h1>
          <p class="statement">Rooted in Biomed &amp; IR.<br />Driven by Code &amp; Business.</p>
        </div>
        <figure class="portrait">
          <img src="/images/miyuki-portrait.jpg" alt="粉色背景的动漫人物侧脸，Miyuki 的个人头像" width="560" height="581" fetchpriority="high" />
          <figcaption>FINANCE <span>/</span> AI <span>/</span> SYSTEMS</figcaption>
        </figure>
      </div>
      <div class="identity-bottom"><p>关于软件、AI 与生活系统的个人研究档案。</p><a href="#directory" class="text-link">探索档案 <ArrowDown size={16} aria-hidden="true" /></a></div>
    </section>

    <section class="directory-section" id="directory" aria-labelledby="directory-title">
      <div class="directory-intro"><p class="eyebrow">01 / Directory</p><h2 id="directory-title">想法有了<br /><em>自己的路径。</em></h2><p>学习、实验与持续构建。<br />这是我的数字工作台。</p><span class="terminal-prompt" aria-hidden="true">~/miyuki <span>$_</span></span><div class="directory-position" aria-hidden="true"><span class="directory-current">01</span><span>/ {String(navigationLinks.length).padStart(2, "0")}</span><div class="directory-progress"><span></span></div></div></div>
      <nav class="directory" aria-label="内容目录">
        {navigationLinks.map((link, index) => (
          <a href={link.href} class="directory-row" data-directory-index={index}>
            <span class="branch" aria-hidden="true">{index === navigationLinks.length - 1 ? "└" : "├"}─</span>
            <div><span class="directory-path">{link.href.slice(1)}</span><h3>{link.label}</h3><p>{directoryMeta[index]}</p></div>
            <ArrowUpRight size={24} stroke-width={1.4} aria-hidden="true" />
          </a>
        ))}
      </nav>
    </section>

    <section class="recent-section" aria-labelledby="recent-title">
      <div class="section-heading"><div><p class="eyebrow">02 / Writing</p><h2 id="recent-title">写作与研究。</h2></div><a href="/blog/" class="text-link">全部文章 <ArrowUpRight size={16} aria-hidden="true" /></a></div>
      <p class="notes-label">最新文章</p>
      <PostList posts={posts.slice(0, 3)} />
    </section>

    <section class="connect-section" aria-labelledby="connect-title">
      <div><p class="eyebrow">03 / Elsewhere</p><h2 id="connect-title">继续交流。</h2></div>
      <ContactLinks />
    </section>
  </div>
</BaseLayout>
<script>
  const section = document.querySelector<HTMLElement>("#directory");
  if (section) {
    const rows = [...section.querySelectorAll<HTMLElement>(".directory-row")];
    const current = section.querySelector<HTMLElement>(".directory-current");
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let scheduled = false;

    const update = () => {
      scheduled = false;
      const focusLine = window.innerHeight * 0.48;
      let active = 0;
      let nearest = Infinity;
      rows.forEach((row, index) => {
        const rect = row.getBoundingClientRect();
        const distance = Math.abs(rect.top + rect.height / 2 - focusLine);
        if (distance < nearest) {
          nearest = distance;
          active = index;
        }
        const offset = motion.matches ? 0 : Math.max(-12, Math.min(12, (rect.top - focusLine) * 0.035));
        row.style.setProperty("--scroll-offset", `${offset}px`);
      });
      rows.forEach((row, index) => row.classList.toggle("is-active", index === active));
      if (current) current.textContent = String(active + 1).padStart(2, "0");
      section.style.setProperty("--directory-progress", String((active + 1) / rows.length));
    };

    const schedule = () => {
      if (!scheduled) {
        scheduled = true;
        window.requestAnimationFrame(update);
      }
    };
    section.classList.add("scroll-ready");
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    motion.addEventListener("change", schedule);
    update();
  }
</script>
<style>
  .home-shell { width: min(1180px, calc(100% - 96px)); margin: 0 auto; }
  .identity { padding: 32px 0 24px; }
  .identity-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; }
  .identity-top > span { color: var(--muted); font: .6875rem var(--mono); }
  .identity-main { display: grid; grid-template-columns: minmax(0, 1fr) 330px; align-items: center; gap: 36px; padding: 40px 0 36px; }
  .hello { margin: 0 0 12px; color: var(--muted); font: .875rem var(--mono); }
  h1 { margin: 0; font-size: 144px; font-weight: 600; line-height: 1; }
  h1 span { color: var(--accent); }
  .statement { margin: 28px 0 0; font-size: 1.5rem; line-height: 1.55; font-weight: 450; }
  .portrait { width: 330px; margin: 0; }
  .portrait img { width: 100%; aspect-ratio: 560 / 581; object-fit: contain; }
  figcaption { margin-top: 12px; color: var(--muted); text-align: center; font: .6875rem var(--mono); }
  figcaption span { margin: 0 8px; color: var(--pink); }
  .identity-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; }
  .identity-bottom p { margin: 0; color: var(--muted); font-size: .875rem; line-height: 1.8; }
  .directory-section { display: grid; grid-template-columns: 1fr 1.8fr; gap: 72px; padding: 48px 0 64px; border-top: 1px solid var(--line); scroll-margin-top: 24px; }
  .directory-intro { position: sticky; top: 48px; align-self: start; }
  .directory-intro h2 { margin: 24px 0; font-size: 2.25rem; font-weight: 500; line-height: 1.45; }
  .directory-intro h2 em { color: var(--accent); font-family: var(--serif); font-style: normal; }
  .directory-intro > p:last-of-type { color: var(--muted); font-size: .875rem; line-height: 1.8; }
  .terminal-prompt { display: block; margin-top: 38px; color: var(--muted); font: .75rem var(--mono); }
  .terminal-prompt > span { color: var(--accent); }
  .directory-position { display: flex; align-items: baseline; gap: 12px; margin-top: 32px; max-width: 240px; color: var(--muted); font: .75rem var(--mono); }
  .directory-current { color: var(--ink); font-size: 2rem; }
  .directory-progress { flex: 1; height: 2px; background: var(--line); align-self: center; margin-left: 12px; overflow: hidden; }
  .directory-progress > span { display: block; height: 100%; background: var(--accent); transform-origin: left; transform: scaleX(var(--directory-progress, .25)); transition: transform .35s ease; }
  .directory { border-top: 1px solid var(--line); }
  .directory-row { display: grid; grid-template-columns: 28px minmax(0, 1fr) 24px; align-items: center; gap: 24px; min-height: 210px; padding: 32px 12px; border-bottom: 1px solid var(--line); transition: background .25s ease, border-color .25s ease, opacity .25s ease; }
  .scroll-ready .directory-row { opacity: .55; }
  .scroll-ready .directory-row > div { transform: translateY(var(--scroll-offset, 0px)); }
  .scroll-ready .directory-row.is-active, .scroll-ready .directory-row:hover, .scroll-ready .directory-row:focus-visible { opacity: 1; border-bottom-color: var(--accent); }
  .directory-row.is-active .directory-path { color: var(--accent); }
  .directory-row:hover, .directory-row:focus-visible { background: var(--surface); border-color: var(--accent); }
  .branch { align-self: start; margin-top: 8px; color: var(--accent); font: 1rem var(--mono); }
  .directory-path { color: var(--muted); font: .6875rem var(--mono); }
  .directory-row h3 { margin: 8px 0 10px; font-size: 1.375rem; line-height: 1.45; font-weight: 500; overflow-wrap: anywhere; }
  .directory-row p { margin: 0; color: var(--cyan); font: .6875rem/1.6 var(--mono); overflow-wrap: anywhere; }
  .directory-row svg { color: var(--accent); transition: transform .18s ease; }
  .directory-row:hover svg { transform: translate(3px, -3px); }
  .recent-section { padding: 56px 0 64px; border-top: 1px solid var(--line); }
  .notes-label { margin: 32px 0 16px; color: var(--muted); font-size: .75rem; }
  .connect-section { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; padding: 40px 0 56px; border-top: 1px solid var(--line); }
  .connect-section h2 { margin: 16px 0 0; font-size: 1.75rem; font-weight: 500; }
  @media (max-width: 1100px) {
    h1 { font-size: 112px; }
    .identity-main { grid-template-columns: minmax(0, 1fr) 260px; }
    .portrait { width: 260px; }
    .directory-section { gap: 40px; }
  }
  @media (max-width: 760px) {
    .home-shell { width: calc(100% - 40px); }
    .identity { padding-top: 24px; }
    .identity-main { position: relative; display: block; padding: 30px 0 22px; }
    .hello { font-size: .75rem; }
    h1 { font-size: 76px; }
    .statement { font-size: 1.0625rem; margin-top: 20px; }
    .portrait { width: 170px; margin: 16px 0 0 auto; }
    figcaption { font-size: .5625rem; }
    figcaption span { margin: 0 4px; }
    .identity-bottom { align-items: start; }
    .identity-bottom p { max-width: 240px; font-size: .8125rem; }
    .directory-section { grid-template-columns: 1fr; gap: 24px; padding: 32px 0 40px; }
    .directory-intro { position: static; }
    .directory-position { margin-top: 20px; max-width: none; }
    .directory-intro h2 { margin: 16px 0; font-size: 1.75rem; }
    .directory-intro h2 br { display: none; }
    .directory-intro > p:last-of-type, .terminal-prompt { display: none; }
    .directory-row { gap: 12px; min-height: 180px; padding: 22px 0; grid-template-columns: 20px minmax(0, 1fr) 24px; }
    .directory-row h3 { font-size: 1.125rem; }
    .recent-section { padding: 40px 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-ready .directory-row { opacity: 1; }
    .scroll-ready .directory-row > div { transform: none; }
  }
  @media (max-width: 359px) { h1 { font-size: 64px; } }
  @media (max-width: 760px) and (max-height: 680px) {
    .identity { padding-top: 16px; }
    .identity-top > span { display: none; }
    .identity-main { padding: 12px 0; }
    .statement { margin-top: 12px; }
    .portrait { width: 80px; margin-top: 0; }
    figcaption { display: none; }
    .identity-bottom { gap: 4px; }
    .identity-bottom p { max-width: none; font-size: .75rem; line-height: 1.6; }
  }
</style>
