---
import BaseLayout from "../layouts/BaseLayout.astro";
const posts = Object.values(import.meta.glob("./posts/*.md", { eager: true }));
const recentPosts = posts
  .sort(
    (a: any, b: any) =>
      new Date(b.frontmatter.pubDate).valueOf() -
      new Date(a.frontmatter.pubDate).valueOf(),
  )
  .slice(0, 3);
---

<BaseLayout
  title="Miyuki — Ideas, Systems & Code"
  description="关于软件、AI 与生活系统的个人研究档案。"
  showFooter={false}
  showHeader={false}
>
  <section class="hero">
    <div class="hero-sky"></div>

    <nav class="home-nav" aria-label="首页导航">
      <a href="/blog/">成为CS工程师</a>
      <a href="/blog/">AI实验室</a>
      <a href="/blog/">Web3 & 一切我感兴趣的</a>
      <a href="/about/">关于我</a>
    </nav>

    <aside class="now-panel" id="now">
      <div>
        <p class="eyebrow">最近在做</p>
      </div>
      <div class="project-block">
        <p class="status"><span></span> 两个系列均已完结</p>
        <h2>从零手写大模型</h2>
        <p>推理篇 15 期 · 训练篇 5 期<br />从模型推理到训练基础，全部完结</p>
        <a class="text-link" href="/blog/">查看系列</a>
      </div>
    </aside>

    <div class="identity">
      <div class="portrait-wrap">
        <img
          src="/images/miyuki-portrait-clean.png"
          alt="举着钞票的蓝发卡通人物"
          width="1254"
          height="1254"
        />
      </div>
      <div class="statement">
        <h1>Rooted in Biomed &amp; IR.<br />Driven by Code &amp; Business.</h1>
        <div class="identity-meta">
          <span>FINANCE</span><i></i><span>AI</span><i></i><span>SYSTEMS</span>
        </div>
        <div class="socials">
          <a href="#" aria-label="X" title="X"
            ><span aria-hidden="true">X</span></a
          >
          <a href="#" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.28-1.29-5.28-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18A10.9 10.9 0 0 1 12 6.11c.98 0 1.95.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.39-5.29 5.68.42.36.79 1.07.79 2.16v3.25c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
              ></path></svg
            >
          </a>
        </div>
      </div>
    </div>

    <aside class="updates-panel">
      <div class="panel-heading"><p class="eyebrow">最近更新</p></div>
      <ul class="updates-list">
        {
          recentPosts.map((post: any, index) => (
            <li class="update-item">
              <a class="update" href={post.url}>
                <div>
                  <>
                    <h2>{post.frontmatter.title}</h2>
                    <p>{post.frontmatter.description}</p>
                  </>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    height: 100svh;
    min-height: 0;
    grid-template-columns: 29% 42% 29%;
    overflow: hidden;
    background: #fff;
  }
  .hero-sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(118deg, #000 0%, #171717 45%, #000 72%);
    background-size: 200% 200%;
    clip-path: polygon(0 0, 39% 0, 61% 100%, 0 100%);
    pointer-events: none;
    animation:
      sky-enter 1.15s cubic-bezier(0.2, 0.8, 0.2, 1) both,
      sky-flow 8s ease-in-out 1.15s infinite alternate;
  }
  .home-nav {
    --nav-offset: -50%;
    position: absolute;
    top: clamp(18px, 3vh, 30px);
    left: 50%;
    z-index: 10;
    display: flex;
    width: min(760px, calc(100% - 64px));
    align-items: center;
    justify-content: space-between;
    transform: translateX(var(--nav-offset));
  }
  .home-nav a {
    position: relative;
    padding: 4px 0;
    color: #111;
    font-family: var(--mono);
    font-size: 1rem;
    font-weight: 650;
  }
  .home-nav a:first-child {
    color: #fff;
  }
  .home-nav a::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }
  .home-nav a:hover::after {
    transform: scaleX(1);
  }
  .home-nav {
    animation: nav-in 0.8s ease 0.25s both;
  }
  .now-panel,
  .updates-panel,
  .identity {
    position: relative;
    z-index: 2;
  }
  .now-panel {
    display: flex;
    height: 100%;
    min-height: 0;
    flex-direction: column;
    justify-content: center;
    gap: clamp(28px, 5vh, 52px);
    padding: 0 28px 0 clamp(36px, 6vw, 96px);
    color: #fff;
    transform: translateY(clamp(30px, 6vh, 56px));
  }
  .now-panel > div:first-child {
    color: #929292;
    font-family: var(--mono);
  }
  .status {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 22px -28px;
    color: #bdbdbd;
    font-family: var(--mono);
    font-size: 0.72rem;
  }
  .status span {
    width: 10px;
    height: 10px;
    flex: 0 0 auto;
    border: 2px solid #fff;
    border-radius: 50%;
    box-shadow: 0 0 0 6px rgba(255, 255, 255, 0.08);
  }
  .project-block {
    width: min(310px, 92%);
    margin: 0;
    padding-left: 28px;
    border-left: 1px solid #424242;
  }
  .project-block h2 {
    margin: 0 0 16px;
    font-family: var(--mono);
    font-size: clamp(1.3rem, 1.8vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .project-block p {
    margin: 0 0 clamp(20px, 3vh, 30px);
    color: #999;
    font-family: var(--mono);
    font-size: 0.76rem;
    line-height: 1.8;
  }
  .identity {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }
  .portrait-wrap {
    position: absolute;
    top: 22%;
    left: 50%;
    display: grid;
    width: min(22vw, 36vh, 310px);
    aspect-ratio: 1;
    place-items: center;
    overflow: visible;
    background: transparent;
    transform: translateX(-50%);
  }
  .portrait-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform-origin: 50% 86%;
    will-change: transform;
    animation: portrait-breeze 5.8s ease-in-out 1.8s infinite;
  }
  .statement {
    position: absolute;
    bottom: 10%;
    left: 50%;
    z-index: 4;
    width: min(900px, 78vw);
    color: #fff;
    text-align: center;
    transform: translateX(-50%);
  }
  .statement h1 {
    margin: 0;
    background: linear-gradient(
      102deg,
      #fff 5%,
      #d6d6d6 44%,
      #171717 66%,
      #666 100%
    );
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 1px #fff) drop-shadow(0 0 1px #111);
    font-family: var(--mono);
    font-size: clamp(1.8rem, 2.5vw, 2.6rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.045em;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .identity-meta {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: clamp(20px, 3vh, 32px);
    color: #fff;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    -webkit-text-stroke: 0.4px #111;
  }
  .identity-meta i {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
  }
  .socials {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: clamp(24px, 4vh, 42px);
  }
  .socials a {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: #fff;
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 800;
    transition:
      color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }
  .socials a:hover {
    background: #fff;
    color: #111;
    transform: translateY(-3px);
  }
  .socials svg {
    width: 19px;
    height: 19px;
  }
  .updates-panel {
    z-index: 5;
    align-self: start;
    margin: clamp(90px, 14vh, 130px) 36px 0 28px;
  }
  .panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0 16px;
    color: #777;
    font-family: var(--mono);
  }
  .panel-heading span {
    font-family: var(--serif);
    font-size: 0.8rem;
  }
  .updates-list {
    margin: 0;
    padding: 2px 0 2px 24px;
    border-left: 1px solid #999;
    list-style: none;
  }
  .update-item {
    position: relative;
  }
  .update {
    display: block;
    padding: 10px 0;
    transition: transform 0.2s ease;
  }
  .update:hover {
    transform: translateX(5px);
  }
  .update h2 {
    margin: 0 0 6px;
    font-family: var(--mono);
    font-size: clamp(0.82rem, 1vw, 1rem);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }
  .update p {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.64rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .arrow {
    align-self: center;
    font-size: 1rem;
  }

  .now-panel > div:first-child {
    animation: rise-in 0.8s ease 0.55s both;
  }
  .project-block {
    animation: rise-in 0.9s ease 0.8s both;
  }
  .coordinates {
    animation: rise-in 0.8s ease 1s both;
  }
  .issue {
    animation: reveal-center 0.8s ease 0.65s both;
  }
  .portrait-wrap {
    animation: portrait-in 1.05s cubic-bezier(0.2, 0.75, 0.2, 1) 0.75s both;
  }
  .statement > p {
    animation: rise-in 0.75s ease 1.05s both;
  }
  .statement h1 {
    animation: rise-in 1.15s cubic-bezier(0.2, 0.75, 0.2, 1) 1.15s both;
  }
  .identity-meta {
    animation: rise-in 0.8s ease 1.5s both;
  }
  .updates-panel {
    animation: panel-in 0.9s cubic-bezier(0.2, 0.75, 0.2, 1) 1.1s both;
  }

  @keyframes sky-enter {
    from {
      transform: translateX(-110%);
    }
    to {
      transform: translateX(0);
    }
  }
  @keyframes sky-flow {
    from {
      background-position: 0% 40%;
    }
    to {
      background-position: 100% 60%;
    }
  }
  @keyframes soft-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes rise-in {
    from {
      opacity: 0;
      filter: blur(7px);
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }
  @keyframes reveal-center {
    from {
      opacity: 0;
      filter: blur(5px);
      transform: translate(-50%, 15px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translate(-50%, 0);
    }
  }
  @keyframes portrait-in {
    from {
      opacity: 0;
      transform: translate(-50%, 24px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0) scale(1);
    }
  }
  @keyframes portrait-breeze {
    0%,
    100% {
      transform: rotate(-0.35deg) skewX(-0.15deg);
    }
    18% {
      transform: rotate(0.55deg) skewX(0.3deg);
    }
    42% {
      transform: rotate(-0.15deg) skewX(-0.1deg);
    }
    63% {
      transform: rotate(0.7deg) skewX(0.25deg);
    }
    82% {
      transform: rotate(-0.5deg) skewX(-0.25deg);
    }
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateX(28px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @keyframes nav-in {
    from {
      opacity: 0;
      filter: blur(5px);
      transform: translate(var(--nav-offset), 16px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translate(var(--nav-offset), 0);
    }
  }

  @media (max-width: 900px) {
    .hero {
      display: flex;
      height: auto;
      min-height: 0;
      flex-direction: column;
    }
    .hero-sky {
      display: none;
    }
    .home-nav {
      --nav-offset: -50%;
      top: 16px;
      left: 50%;
      width: calc(100% - 28px);
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px 20px;
      transform: translateX(var(--nav-offset));
    }
    .home-nav a {
      font-size: .875rem;
    }
    .home-nav a:first-child {
      color: #111;
    }
    .identity {
      order: 1;
      min-height: 660px;
      background: #fff;
    }
    .portrait-wrap {
      top: 22%;
      width: min(56vw, 235px);
    }
    .statement {
      right: auto;
      bottom: 48px;
      left: 50%;
      width: calc(100% - 28px);
      color: #111;
      transform: translateX(-50%);
    }
    .statement h1 {
      background: linear-gradient(110deg, #111, #777);
      background-clip: text;
      color: transparent;
      filter: none;
      font-size: clamp(2rem, 9vw, 3.5rem);
      line-height: 1;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .identity-meta {
      margin-top: 18px;
      color: #111;
      -webkit-text-stroke: 0;
    }
    .socials {
      margin-top: 28px;
    }
    .socials a {
      color: #111;
    }
    .now-panel {
      order: 2;
      min-height: 500px;
      padding: 70px 28px;
      background: #000;
      transform: none;
    }
    .project-block {
      margin: 0;
    }
    .updates-panel {
      order: 3;
      margin: 0;
      padding: 48px 28px 60px;
      background: #fff;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-sky,
    .home-nav,
    .now-panel > div:first-child,
    .project-block,
    .portrait-wrap,
    .portrait-wrap img,
    .statement h1,
    .identity-meta,
    .updates-panel {
      animation: none;
    }
  }
</style>
