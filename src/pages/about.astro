---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="关于 — Miyuki" description="认识 Miyuki，一名关注产品、软件与人工智能的工程师。">
  <div class="inner-page about">
    <div class="page-kicker"><p class="eyebrow">About / 关于我</p><span>Based in Amsterdam</span></div>
    <div class="about-grid">
      <div class="portrait" aria-label="个人照片位置"><span>M</span></div>
      <div class="about-copy">
        <h1>你好，<br />我是 <em>Miyuki.</em></h1>
        <p class="lead">我是一名软件工程师，也是一名长期主义的学习者。</p>
        <p>这个网站是我的数字工作台。我在这里记录构建软件的过程、对人工智能的理解，以及那些帮助我更清晰地思考和生活的系统。</p>
        <p>我相信好的技术应该让复杂的事变得可理解，也相信公开写作是检验想法最诚实的方式。</p>
        <div class="contact"><span class="eyebrow">Elsewhere</span><a href="mailto:hello@example.com">Email ↗</a><a href="https://github.com/" rel="noreferrer">GitHub ↗</a></div>
      </div>
    </div>
    <div class="principles">
      <div><span>01</span><h2>保持好奇</h2><p>从问题出发，不急着接受最顺手的答案。</p></div>
      <div><span>02</span><h2>写下来</h2><p>模糊的直觉经过表达，才会成为可以讨论的想法。</p></div>
      <div><span>03</span><h2>持续构建</h2><p>用小而真实的作品，让知识获得形状。</p></div>
    </div>
  </div>
</BaseLayout>
<style>
  .page-kicker > span { font-family: monospace; font-size: .65rem; text-transform: uppercase; }
  .about-grid { display: grid; grid-template-columns: minmax(280px, .8fr) 1.2fr; gap: clamp(50px, 9vw, 130px); align-items: center; padding: 72px 0 90px; }
  .portrait { position: relative; display: grid; aspect-ratio: 4 / 5; align-self: end; place-items: center; overflow: hidden; border: 1px solid var(--ink); background: linear-gradient(145deg, var(--white) 0 58%, var(--sky) 58%); }
  .portrait::before { position: absolute; width: 72%; aspect-ratio: 1; border: 1px solid var(--ink); border-radius: 50%; content: ""; }
  .portrait span { position: relative; z-index: 1; font-family: var(--serif); font-size: clamp(8rem, 20vw, 16rem); font-style: italic; }
  .about-copy h1 { margin: 0 0 38px; font-family: var(--serif); font-size: clamp(3.5rem, 7vw, 7rem); font-weight: 400; line-height: .86; letter-spacing: -.055em; }
  .about-copy h1 em { font-weight: 400; }
  .about-copy > p { max-width: 600px; color: var(--muted); font-size: .95rem; line-height: 1.85; }
  .about-copy .lead { color: var(--ink); font-family: var(--serif); font-size: 1.45rem; line-height: 1.45; }
  .contact { display: flex; flex-wrap: wrap; gap: 22px; align-items: center; margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--line); }
  .contact a { font-size: .72rem; font-weight: 800; text-transform: uppercase; }
  .principles { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .principles > div { min-height: 210px; padding: 28px; border-right: 1px solid var(--line); }
  .principles > div:last-child { border-right: 0; }
  .principles span { font-family: monospace; font-size: .62rem; }
  .principles h2 { margin: 44px 0 12px; font-family: var(--serif); font-size: 1.8rem; font-weight: 400; }
  .principles p { margin: 0; color: var(--muted); font-size: .76rem; line-height: 1.6; }
  @media (max-width: 720px) {
    .about-grid { grid-template-columns: 1fr; gap: 48px; padding: 44px 0 60px; }
    .portrait { max-width: 420px; }
    .principles { grid-template-columns: 1fr; }
    .principles > div { min-height: 170px; border-right: 0; border-bottom: 1px solid var(--line); }
    .principles > div:last-child { border-bottom: 0; }
  }
</style>
