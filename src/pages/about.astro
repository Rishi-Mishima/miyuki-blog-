---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactLinks from "../components/ContactLinks.astro";
---
<BaseLayout title="关于 — Miyuki" description="认识 Miyuki，一名关注产品、软件与人工智能的工程师。">
  <section class="inner-page about">
    <div class="page-kicker"><p class="eyebrow">~/miyuki/about/</p><span>Based in Amsterdam</span></div>
    <div class="about-grid">
      <figure class="portrait"><img src="/images/miyuki-portrait.jpg" alt="粉色背景的动漫人物侧脸，Miyuki 的个人头像" width="560" height="581" /><figcaption>MIYUKI / FINANCE · AI · SYSTEMS</figcaption></figure>
      <div class="about-copy">
        <p class="eyebrow">About / 关于我</p>
        <h1>你好，<br />我是 <em>Miyuki.</em></h1>
        <p class="lead">我是一名软件工程师，也是一名长期主义的学习者。</p>
        <p>这个网站是我的数字工作台。我在这里记录构建软件的过程、对人工智能的理解，以及那些帮助我更清晰地思考和生活的系统。</p>
        <p>我相信好的技术应该让复杂的事变得可理解，也相信公开写作是检验想法最诚实的方式。</p>
        <div class="contact"><span class="eyebrow">Elsewhere</span><ContactLinks /></div>
      </div>
    </div>
    <div class="principles">
      <div><span>01 / Curiosity</span><h2>保持好奇</h2><p>从问题出发，不急着接受最顺手的答案。</p></div>
      <div><span>02 / Writing</span><h2>写下来</h2><p>模糊的直觉经过表达，才会成为可以讨论的想法。</p></div>
      <div><span>03 / Building</span><h2>持续构建</h2><p>用小而真实的作品，让知识获得形状。</p></div>
    </div>
  </section>
</BaseLayout>
<style>
  .about-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 80px; align-items: center; padding: 64px 0 80px; }
  .portrait { margin: 0; }
  .portrait img { width: 100%; aspect-ratio: 560 / 581; object-fit: contain; }
  figcaption { margin-top: 24px; text-align: center; color: var(--muted); font: .6875rem var(--mono); }
  h1 { margin: 24px 0 28px; font-size: 3.75rem; font-weight: 500; line-height: 1.2; }
  h1 em { color: var(--accent); font-family: var(--serif); font-weight: 400; }
  .about-copy > p:not(.eyebrow) { color: var(--muted); font-size: .9375rem; line-height: 1.9; }
  .about-copy .lead { color: var(--ink) !important; font-size: 1.125rem !important; }
  .contact { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--line); }
  .principles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid var(--line); }
  .principles > div { padding: 32px 28px; border-right: 1px solid var(--line); }
  .principles > div:first-child { padding-left: 0; }
  .principles > div:last-child { border-right: 0; }
  .principles span { color: var(--cyan); font: .6875rem var(--mono); }
  .principles h2 { margin: 32px 0 12px; font-size: 1.5rem; font-weight: 500; }
  .principles p { margin: 0; color: var(--muted); font-size: .875rem; line-height: 1.8; }
  @media (max-width: 760px) {
    .about-grid { grid-template-columns: 1fr; gap: 36px; padding: 40px 0; }
    .portrait { width: min(240px, 100%); margin: 0 auto; }
    h1 { font-size: 2.75rem; }
    .principles { grid-template-columns: 1fr; }
    .principles > div { padding: 28px 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .principles > div:last-child { border-bottom: 0; }
    .principles h2 { margin-top: 16px; }
  }
</style>
