---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactLinks from "../components/ContactLinks.astro";
import { posts } from "../data/posts";
import { ArrowUpRight } from "@lucide/astro";
const sections = [
  { id: "profile", label: "个人简介", en: "Profile" },
  { id: "development", label: "开发与探索", en: "Development" },
  { id: "activity", label: "近期动态", en: "Recent activity" },
  { id: "contact", label: "联系我", en: "Contact" },
];
const interests = ["Biomed", "International Relations", "Code", "AI", "Business"];
const explorations = [
  { href: "/cs-engineer/", title: "计算机与软件", en: "Computer science", text: "记录软件构建的过程，整理计算机知识与工程实践。", tags: ["Code", "Systems", "Learning"] },
  { href: "/ai-lab/", title: "人工智能实验", en: "AI experiments", text: "探索模型、智能体，以及 AI 如何进入真实的工作与生活。", tags: ["Models", "Agents", "Experiments"] },
  { href: "/web3/", title: "跨学科的好奇心", en: "Beyond the code", text: "从 Web3、金融与商业出发，连接生物医学与国际关系的视角。", tags: ["Web3", "Finance", "DeSci"] },
];
---
<BaseLayout title="关于我 — Miyuki" description="认识 Miyuki：从生物医学与国际关系出发，探索代码、AI 与商业。">
  <div class="inner-page about">
    <div class="page-kicker"><p class="eyebrow">~/miyuki/about/</p><span>Amsterdam, NL</span></div>
    <header class="about-hero">
      <img src="/images/miyuki-portrait.jpg" alt="Miyuki 的动漫人物头像" width="560" height="581" fetchpriority="high" />
      <div><p class="eyebrow">Hello, nice to meet you / 很高兴认识你</p><h1>你好，这里是 <span>Miyuki.</span></h1><p class="hero-line">Rooted in Biomed &amp; IR. Driven by Code &amp; Business.</p><p class="hero-note">保持好奇，写下思考，把想法慢慢做出来。</p></div>
    </header>
    <div class="about-body">
      <aside class="contents"><p class="eyebrow">On this page / 本页目录</p><nav aria-label="关于我页内目录">{sections.map((section, index) => <a href={`#${section.id}`}><span>0{index + 1}</span>{section.label}<ArrowUpRight size={14} aria-hidden="true" /></a>)}</nav><p class="aside-note">A little about me,<br />and what keeps me curious.</p></aside>
      <div class="about-sections">
        <section id="profile" aria-labelledby="profile-title">
          <h2 id="profile-title">个人简介 <span>Profile</span><a href="#profile" aria-label="链接到个人简介">#</a></h2>
          <div class="badges" aria-label="关注领域">{interests.map((interest) => <span>{interest}</span>)}</div>
          <p class="lead">我是 Miyuki，一名长期主义的学习者。</p>
          <p>我的兴趣从生物医学与国际关系延伸到代码、人工智能和商业。我喜欢在不同领域之间寻找联系，也喜欢把复杂的问题拆解成可以理解、可以尝试的小步骤。</p>
          <p>这个博客是我的数字工作台：记录学习笔记、开发过程，以及那些帮助我更清晰地思考和生活的系统。</p>
          <blockquote>用写作整理思考，用构建检验想法。<span>Think clearly. Build steadily.</span></blockquote>
        </section>
        <section id="development" aria-labelledby="development-title">
          <h2 id="development-title">开发与探索 <span>Development</span><a href="#development" aria-label="链接到开发与探索">#</a></h2>
          <p>我关注的几个方向，也是在这个博客里持续整理的内容。</p>
          <div class="explorations">{explorations.map((item) => <a class="exploration" href={item.href}><div class="exploration-title"><div><span class="eyebrow">{item.en}</span><h3>{item.title}</h3></div><ArrowUpRight size={20} aria-hidden="true" /></div><p>{item.text}</p><div class="tag-list">{item.tags.map((tag) => <span>{tag}</span>)}</div></a>)}</div>
        </section>
        <section id="activity" aria-labelledby="activity-title">
          <h2 id="activity-title">近期动态 <span>Recent activity</span><a href="#activity" aria-label="链接到近期动态">#</a></h2>
          <p>最近写下的笔记与研究。学习的过程，也在这里留下痕迹。</p>
          <ol class="activity-list">{posts.slice(0, 3).map((post) => <li><time datetime={post.date.toISOString()}>{post.date.toISOString().slice(0, 10)}</time><a href={post.url}><h3>{post.title}<ArrowUpRight size={16} aria-hidden="true" /></h3><p>{post.description}</p></a></li>)}</ol>
          <a class="text-link" href="/blog/">浏览全部文章 <ArrowUpRight size={16} aria-hidden="true" /></a>
        </section>
        <section id="contact" aria-labelledby="contact-title">
          <h2 id="contact-title">联系我 <span>Contact</span><a href="#contact" aria-label="链接到联系我">#</a></h2>
          <p>如果你也对这些话题感兴趣，欢迎在 GitHub 找到我，交流想法与作品。</p>
          <ContactLinks />
          <p class="signature">Miyuki <span>♡</span></p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
<style>
  .about-hero { display: flex; align-items: center; gap: 40px; padding: 48px 0; border-bottom: 1px solid var(--line); }
  .about-hero img { width: 152px; height: 152px; border-radius: 50%; object-fit: cover; border: 1px solid var(--line); padding: 6px; background: var(--surface); }
  h1 { margin: 16px 0; font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 550; letter-spacing: -.04em; line-height: 1.3; }
  h1 span { color: var(--accent); }
  .hero-line { margin: 0; color: var(--ink); font-size: .9375rem; line-height: 1.7; }
  .hero-note { margin: 10px 0 0; color: var(--muted); font-size: .875rem; line-height: 1.8; }
  .about-body { display: grid; grid-template-columns: 224px minmax(0, 1fr); gap: 72px; padding-top: 48px; }
  .contents { position: sticky; top: 32px; align-self: start; }
  .contents .eyebrow { font-size: .625rem; }
  .contents nav { display: grid; margin-top: 24px; }
  .contents nav a { display: flex; align-items: center; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: .8125rem; }
  .contents nav a:hover, .contents nav a:focus-visible { color: var(--accent); }
  .contents nav a > span { font: .625rem var(--mono); color: var(--accent); }
  .contents nav svg { margin-left: auto; }
  .aside-note { margin-top: 32px; font: .6875rem/1.9 var(--mono); color: var(--muted); }
  section { scroll-margin-top: 32px; padding-bottom: 40px; }
  section + section { padding-top: 32px; border-top: 1px solid var(--line); }
  h2 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; margin: 0 0 24px; font-size: 1.5rem; font-weight: 550; }
  h2 > span { color: var(--muted); font: .8125rem var(--mono); }
  h2 > a { margin-left: auto; color: var(--accent); font: 1rem var(--mono); }
  section > p, .exploration p { color: var(--muted); font-size: .9375rem; line-height: 1.95; }
  section > .lead { color: var(--ink); font-size: 1.125rem; margin-top: 24px; }
  .badges { display: flex; flex-wrap: wrap; gap: 8px; }
  .badges span { padding: 7px 10px; border: 1px solid var(--line); background: var(--surface); color: var(--cyan); font: .6875rem/1.4 var(--mono); }
  .badges span:nth-child(2n) { color: var(--pink); }
  blockquote { margin: 28px 0 0; padding: 16px 24px; border-left: 2px solid var(--accent); background: var(--surface); font-size: .9375rem; line-height: 1.8; }
  blockquote > span { display: block; margin-top: 6px; color: var(--muted); font: .6875rem/1.8 var(--mono); }
  .explorations { display: grid; gap: 12px; margin-top: 24px; }
  .exploration { padding: 24px; border: 1px solid var(--line); transition: border-color .2s, background .2s; }
  .exploration:hover { border-color: var(--accent); background: var(--surface); }
  .exploration-title { display: flex; justify-content: space-between; gap: 16px; }
  .exploration-title svg { color: var(--accent); }
  .exploration .eyebrow { font-size: .625rem; }
  .exploration h3 { margin: 8px 0 0; font-weight: 500; font-size: 1.125rem; }
  .exploration p { margin: 12px 0 16px; font-size: .875rem; }
  .activity-list { padding: 0; margin: 28px 0 12px; list-style: none; }
  .activity-list li { display: grid; grid-template-columns: 100px minmax(0, 1fr); gap: 24px; padding: 24px 0; border-bottom: 1px solid var(--line); }
  time { color: var(--cyan); font: .6875rem/2 var(--mono); }
  .activity-list h3 { display: flex; justify-content: space-between; gap: 16px; margin: 0; font-size: 1rem; line-height: 1.6; font-weight: 500; }
  .activity-list a:hover h3 { color: var(--accent); }
  .activity-list p { margin: 8px 0 0; color: var(--muted); font-size: .8125rem; line-height: 1.8; }
  section > .signature { margin-top: 40px; color: var(--ink); font: italic 1.75rem var(--serif); }
  .signature span { color: var(--pink); }
  @media (max-width: 1000px) { .about-body { grid-template-columns: 180px minmax(0, 1fr); gap: 40px; } }
  @media (max-width: 760px) {
    .about-hero { flex-direction: column; align-items: start; gap: 24px; padding: 32px 0; }
    .about-hero img { width: 100px; height: 100px; }
    .about-hero .eyebrow { font-size: .625rem; line-height: 1.8; }
    .about-body { grid-template-columns: 1fr; gap: 32px; padding-top: 24px; }
    .contents { position: static; }
    .contents nav { grid-template-columns: 1fr 1fr; column-gap: 20px; margin-top: 12px; }
    .aside-note { display: none; }
    h2 { gap: 8px; font-size: 1.25rem; }
    h2 > span { font-size: .6875rem; }
    .exploration { padding: 20px; }
    .activity-list li { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
